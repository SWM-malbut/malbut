{
  "device_id": "REPLACE_WITH_REGISTERED_DEVICE_ID",
  "journal_path": "/var/lib/malbut-falls/events.sqlite",
  "cloud_key_file": "/etc/malbut/ollama-cloud.key",
  "model": "gemma4:31b",
  "image_topic": "/depth_cam/rgb0/image_raw",
  "retention_s": 10,
  "buffer_bytes": 16777216,
  "buffer_frames": 64,
  "input_fps": 5,
  "max_source_age_s": 1,
  "control_lease_s": 5,
  "policy": {
    "retry_interval_s": 3,
    "max_person_observation_age_s": 2,
    "clip_window_s": 5,
    "max_frame_age_s": 2,
    "max_calls_per_minute": 5,
    "max_incidents": 10,
    "max_images": 12
  }
}
