MALBUT_AGENT_PROVIDER=mock
# proposal (default, no adapter execution) or explicit local simulation
MALBUT_AGENT_TOOL_MODE=proposal
MALBUT_AGENT_HOST=127.0.0.1
MALBUT_AGENT_PORT=8765
MALBUT_AGENT_DB=/tmp/malbut-agent.sqlite3
MALBUT_AGENT_USER_ID=local-user
MALBUT_AGENT_AUTH_TOKEN=
# Opt-in authenticated text-only speech simulator. This is not microphone,
# STT, TTS, RobotState, or physical Tool authority. A 32-512 character
# visible-ASCII auth token is mandatory when this flag is true.
MALBUT_AGENT_ENABLE_SCRIPTED_SPEECH=false
# Invalid bearer attempts use a separate limiter, so they cannot guess without
# bounds or consume the authenticated request bucket.
MALBUT_AGENT_FAILED_AUTH_ATTEMPTS_PER_MINUTE=30
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_FALLBACK_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_REASONING_EFFORT=none
OPENAI_MAX_OUTPUT_TOKENS=500
MALBUT_AGENT_TIMEOUT_SECONDS=5
MALBUT_AGENT_PROVIDER_TOTAL_TIMEOUT_SECONDS=11
MALBUT_AGENT_PROVIDER_MAX_RETRIES=0
MALBUT_AGENT_PROVIDER_RETRY_BASE_DELAY_MS=250
MALBUT_AGENT_PROVIDER_RETRY_MAX_DELAY_MS=1000
MALBUT_AGENT_PROVIDER_FAILURE_THRESHOLD=2
MALBUT_AGENT_PROVIDER_RECOVERY_TIMEOUT_SECONDS=30
MALBUT_AGENT_MEMORY_LIMIT=5
MALBUT_AGENT_CONVERSATION_TTL_SECONDS=1800
MALBUT_AGENT_CONVERSATION_HISTORY_LIMIT=10
MALBUT_AGENT_CONVERSATION_SUMMARY_MAX_CHARS=2000
MALBUT_AGENT_MAX_MODEL_INPUT_CHARS=20000
MALBUT_AGENT_MAX_CONCURRENT_REQUESTS=8
MALBUT_AGENT_REQUESTS_PER_MINUTE=60

# Optional, all-or-nothing proposal-time Homecam semantic binding. The URL
# must be a public-DNS HTTPS origin on port 443. Keep both independent secrets
# and the stable principal digest outside Git. This never grants physical
# execution authority.
MALBUT_HOMECAM_ORIGIN=
MALBUT_HOMECAM_AGENT_TOKEN=
MALBUT_HOMECAM_SIGNING_SECRET=
MALBUT_HOMECAM_PRINCIPAL_SUBJECT_DIGEST=
MALBUT_HOMECAM_DEVICE_ID=
MALBUT_HOMECAM_TIMEOUT_SECONDS=3

# Optional request-scoped trusted RobotState UDS client. SOCKET_PATH,
# EXPECTED_UID, and DEVICE_ID are one all-or-nothing server-owned binding;
# TIMEOUT_SECONDS is bounded to 1-5 seconds. The Agent-side client/wiring and
# ROS-independent bounded UDS collector core and a separate read-only
# malbut_gazebo Nav2/localization observer are implemented. The observer is
# not auto-started and authoritative battery/e-stop/camera/privacy/zone
# sources are still absent, so leave these empty by default.
MALBUT_ROBOT_STATE_SOCKET_PATH=
MALBUT_ROBOT_STATE_EXPECTED_UID=
MALBUT_ROBOT_STATE_DEVICE_ID=
MALBUT_ROBOT_STATE_TIMEOUT_SECONDS=2

# Exact comma-separated server-owned room allowlist. Non-empty rooms require
# complete Homecam and RobotState bindings whose DEVICE_ID values match.
# Empty is the fail-closed production default.
MALBUT_AGENT_MONITORABLE_ROOMS=

# Explicit one-shot Agent -> Gazebo simulation preparation. The default is
# disabled and starts no worker, socket exchange, ROS call, or stream action.
# Enabling requires TOOL_MODE=simulation, a file-backed absolute DB, a strong
# HTTP bearer, all Homecam/RobotState bindings above, matching device IDs, and
# at least one monitorable room. Keep the independent authority secret outside
# Git; it must remain stable across server restarts for exact proof replay.
MALBUT_AGENT_ENABLE_GAZEBO_SIMULATION_EXECUTION=false
MALBUT_AGENT_GAZEBO_SIMULATION_AUTHORITY_SECRET=
MALBUT_AGENT_GAZEBO_PREPARE_SOCKET_PATH=
MALBUT_AGENT_GAZEBO_PREPARE_EXPECTED_UID=
MALBUT_AGENT_GAZEBO_PREPARE_TIMEOUT_SECONDS=2
MALBUT_AGENT_GAZEBO_PREPARE_LEASE_SECONDS=30
