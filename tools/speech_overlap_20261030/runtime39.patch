+    p.on_duck_control('pid',old,False);assert p._duck_clear_after is None
+    harness.now=.3;p.feed(audio(harness,QUIET));assert p._ducked_playback is None
+    p.feed(audio(harness,VOICE*8));new=p.duck_control_token('pid');assert new!=old
+    p.on_duck_control('pid',old,True,issued_at=harness.now);assert p._duck_clear_after is None
+    p.on_duck_control('other',new,True,issued_at=harness.now);assert p._duck_clear_after is None
+    p.on_duck_control('pid',new,True,issued_at=harness.now);deadline=p._duck_clear_after
+    harness.now=.45;p.on_duck_control('pid',new,True,issued_at=harness.now);assert p._duck_clear_after==deadline
