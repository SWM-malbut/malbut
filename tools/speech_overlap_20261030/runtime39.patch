+"""Exact saved startup inputs; these are local replay, not new physical trials."""
+from pathlib import Path
+
+import numpy as np
+import pytest
+import soundfile as sf
+
+from malbut_stt.echo.startup_phase import probe_window, _delay
+from malbut_stt.echo.startup_phase_estimator import estimate
+
+CANDIDATE = Path(__file__).resolve().parents[1]
+ROOT = CANDIDATE.parents[2]
+PROFILES = CANDIDATE / 'diverse_spatial/phase_reference.npz'
+
+
+@pytest.mark.parametrize('name,expected', [
+    ('live_runtime05_stop01', [0]*6),
+    ('live_runtime05_stop02', [0]*6),
+    ('live_runtime02_correction01', [0,0,1,1,1,1]),
+    ('live_runtime06_stop01', [0,0,0,1,0,1]),
+])
+def test_exact_recorded_probe_all_windows_agree(name, expected):
+    folder = ROOT / 'work' / name
+    if name != 'live_runtime02_correction01':
+        with np.load(folder / 'capture_phase_input.npz') as saved:
+            raw, render = saved['raw6'], saved['render']
+    else:
+        probe, _ = sf.read(ROOT / 'backup/releases/aec-20261028/calibration.wav', dtype='float32')
+        with np.load(folder / 'capture_training.npz') as saved:
+            begin, end, render, _ = probe_window(saved['timing'], saved['far'], probe)
+        raw = np.fromfile(folder / 'bridge_raw8.pcm', '<i2').reshape(-1, 8)
+        raw = raw[175744+begin:175744+end, :6].astype('f4') / 32768
+    result = estimate(raw, render, PROFILES)
+    assert result['delays'] == expected
+    rows = result['evidence']['comparisons']
+    intervals = [row for row in rows if row['reference_case'] == 1 and row['channel'] == 1]
+    assert result['evidence']['window_count'] == len(intervals) == 6
+    assert intervals[0]['sample_interval'][0] == 0
+    assert intervals[-1]['sample_interval'][1] == len(raw)
+    assert all(left['sample_interval'][1] == right['sample_interval'][0]
+               for left, right in zip(intervals, intervals[1:]))
+    assert all(0 < row['sample_interval'][1]-row['sample_interval'][0] <= 16000
+               for row in intervals)
+    assert all(sum(row['half'] == half for row in intervals) >= 2 for half in (0, 1))
+    assert len(rows) == len(intervals) * 2 * 5
+    assert all(abs(row['delay'] - expected[row['channel']-1]) <= .15 for row in rows)
+    if name == 'live_runtime06_stop01':
+        with np.load(folder / 'capture_phase_input.npz') as saved:
+            raw_start = int(saved['raw_start'])
+        physical = np.fromfile(next((folder / 'runtime_state').glob('run-*/bridge_raw8.pcm')), '<i2').reshape(-1, 8)
+        pcm = np.rint(raw * 32768).astype('<i2')
+        assert np.array_equal(pcm, physical[raw_start:raw_start+len(raw), :6])
+        corrected = _delay(pcm, physical[raw_start-1, :6], expected)
+        assert estimate(corrected, render, PROFILES)['delays'] == [0]*6
