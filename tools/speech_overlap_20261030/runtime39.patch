+"""Subsample startup calibration without a model or sound device."""
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+from malbut_stt.echo.startup_phase_estimator import estimate
+from malbut_stt.echo.startup_phase import _phase_weights, _valid_delays
+from test_startup_phase_estimator import signals
+
+
+def advance(raw, delays):
+    omega = 2 * np.pi * np.fft.rfftfreq(len(raw))
+    return np.fft.irfft(np.fft.rfft(raw, axis=0) *
+                       np.exp(1j * omega[:, None] * delays), n=len(raw), axis=0).astype('f4')
+
+
+def test_fractional_channels_recovered_without_rounding(signals):
+    raw, render, path, _ = signals
+    delays = np.array([0, 0, .6, .3, .6, .3])
+    measured = estimate(advance(raw, delays), render, path)['delays']
+    np.testing.assert_allclose(measured, delays, atol=.03)
+
+
+def test_fractional_phase_change_within_probe_is_rejected(signals):
+    raw, render, path, _ = signals
+    changed = advance(raw, np.array([0, 0, .2, .3, .2, .3]))
+    changed[len(raw)//2:] = advance(raw, np.array([0, 0, .6, .3, .6, .3]))[len(raw)//2:]
+    with pytest.raises(ValueError, match='disagrees'):
+        estimate(changed, render, path)
+
+
+def test_saved_reboot_capture_has_bounded_fractional_phase():
+    root = Path(__file__).resolve().parents[3]
+    with np.load(root/'live_runtime19_resume_followup_b2/capture_phase_input.npz') as saved:
+        result = estimate(saved['raw6'], saved['render'],
+                          Path(__file__).resolve().parents[1]/'diverse_spatial/phase_reference.npz')
+    np.testing.assert_allclose(result['delays'], [0, 0, .59, .30, .59, .30], atol=.07)
+
+
+def test_weight_rotation_preserves_spectrum_magnitude_and_cancels_phase():
+    rng = np.random.default_rng(4)
+    weights = rng.normal(size=(257,6)) + 1j*rng.normal(size=(257,6))
+    source = rng.normal(size=(257,6)) + 1j*rng.normal(size=(257,6))
+    delays = [0,0,.6,.3,.6,.3]
+    assert _valid_delays(delays)
+    corrected = _phase_weights(weights, delays)
+    advanced_spectrum = source*np.exp(2j*np.pi*np.fft.rfftfreq(512)[:,None]*delays)
+    np.testing.assert_allclose(abs(corrected), abs(weights), atol=1e-14)
+    np.testing.assert_allclose((corrected.conj()*advanced_spectrum).sum(axis=1),
+                               (weights.conj()*source).sum(axis=1), atol=1e-14)
+    assert _phase_weights(weights, [0,0,1,0,1,1]) is weights
+
+
+@pytest.mark.parametrize("shift", [-1., -.4])
