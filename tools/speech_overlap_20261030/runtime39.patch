+"""Qualified quiet-gap retention only; local PCM/events, not acoustic acceptance."""
+import pytest
+from malbut_stt.audio import CapturePCM, CaptureSettings, UtteranceCollector
+from malbut_stt.streaming import StreamingUtteranceCollector
+from test_dialogue_pipeline import harness, VOICE, QUIET
+from test_post_duck_confirmation import reply, audio
+
+
+def make(stream=True):
+    settings = CaptureSettings(min_speech_s=.16, pre_roll_s=2, silence_timeout_s=1)
+    detector = lambda pcm, rate: any(pcm)
+    return (StreamingUtteranceCollector(detector, settings=settings) if stream else
+            UtteranceCollector(16000, detector, settings))
+
+
+def inner(c):
+    return getattr(c, 'collector', c)
+
+
+@pytest.mark.parametrize('stream', [False, True])
+def test_qualified_gap_preserves_exact_asr_pcm_without_counting_quiet_as_voice(stream):
+    c = make(stream)
+    prefix = b'\x02\x00' * 320
+    quiet_asr = b'\x03\x00' * 1600
+    c.feed(CapturePCM(prefix, QUIET), can_start=False, hold_qualified=True)
+    c.feed(VOICE * 9, can_start=False, hold_qualified=True)
+    last_voice = inner(c).candidate_last_voiced_frame
+    c.feed(CapturePCM(quiet_asr, QUIET * 5), can_start=False, hold_qualified=True)
+    assert inner(c).candidate_frames == 9 and inner(c).candidate_elapsed_frames == 14
+    assert inner(c).candidate_last_voiced_frame == last_voice
+    assert not inner(c).started
+    c.feed(VOICE, can_start=True, hold_qualified=True)
+    assert inner(c).started
+    assert bytes(inner(c).audio) == prefix + VOICE * 9 + quiet_asr + VOICE
+    assert inner(c).voiced_frames == 10 and inner(c).speech_frames == 15
+    assert inner(c).snapshot('partial').voiced_s == .2
+
+
+@pytest.mark.parametrize('stream', [False, True])
+def test_subqualified_blips_never_accumulate(stream):
+    c = make(stream)
+    for _ in range(6):
+        c.feed(VOICE * 7, can_start=False, hold_qualified=True)
+        c.feed(QUIET, can_start=False, hold_qualified=True)
+        assert inner(c).candidate_frames == 0
+    c.feed(VOICE, can_start=True, hold_qualified=True)
+    assert not inner(c).started and inner(c).candidate_frames == 1
+
+
+@pytest.mark.parametrize('stream', [False, True])
+@pytest.mark.parametrize('gap, starts', [(16, True), (17, False)])
+def test_320ms_gap_kept_but_340ms_gap_expires(stream, gap, starts):
+    c = make(stream)
+    c.feed(VOICE * 8, can_start=False, hold_qualified=True)
+    c.feed(QUIET * gap, can_start=False, hold_qualified=True)
+    assert not inner(c).started
+    c.feed(VOICE, can_start=True, hold_qualified=True)
+    assert inner(c).started is starts
+
+
+@pytest.mark.parametrize('stream', [False, True])
+def test_silence_without_clearance_never_confirms_and_hold_is_default_off(stream):
+    c = make(stream)
+    c.feed(VOICE * 8, can_start=False)
+    c.feed(QUIET, can_start=False)
+    assert inner(c).candidate_frames == 0
+    c.feed(VOICE * 8, can_start=False, hold_qualified=True)
+    c.feed(QUIET * 20, can_start=False, hold_qualified=True)
+    assert not inner(c).started and not inner(c).candidate_audio
+
+
+@pytest.mark.parametrize('stream', [False, True])
+def test_mixed_partial_quiet_frame_cannot_borrow_new_hold_permission(stream):
+    c = make(stream)
+    c.feed(VOICE * 8, can_start=False, hold_qualified=True)
+    c.feed(QUIET[:320], can_start=False, hold_qualified=False)
+    c.feed(QUIET[320:], can_start=False, hold_qualified=True)
+    assert inner(c).candidate_frames == 0
+    c.feed(VOICE, can_start=True, hold_qualified=True)
+    assert not inner(c).started
+
+
+@pytest.mark.parametrize('stream', [False, True])
+def test_elapsed_pending_cap_counts_retained_quiet(stream):
+    c = make(stream)
+    c.feed(VOICE * 8, can_start=False, hold_qualified=True)
+    c.feed((QUIET * 10 + VOICE) * 8, can_start=False, hold_qualified=True)
+    assert inner(c).candidate_elapsed_frames == 96
+    assert inner(c).candidate_frames == 16
+    c.feed(QUIET * 4, can_start=False, hold_qualified=True)
+    assert not inner(c).candidate_audio and inner(c).candidate_elapsed_frames == 0
+    c.feed(VOICE, can_start=True, hold_qualified=True)
+    assert not inner(c).started
+
+
+@pytest.mark.parametrize('stream', [False, True])
+@pytest.mark.parametrize('hold, expected', [(False, 110), (True, 10)])
+def test_default_off_preserves_existing_longer_denied_start_limit(stream, hold, expected):
+    settings = CaptureSettings(min_speech_s=.16, pre_roll_s=3)
+    detector = lambda pcm, rate: any(pcm)
+    c = (StreamingUtteranceCollector(detector, settings=settings) if stream else
+         UtteranceCollector(16000, detector, settings))
+    c.feed(VOICE * 110, can_start=False, hold_qualified=hold)
+    assert inner(c).candidate_frames == expected
+
+
+def feed_at(p, harness, t, pcm, ack=True, stamp=None):
+    harness.now = t
+    before = len(harness.controls)
+    p.feed(audio(harness, pcm, stamp=stamp))
+    if ack and len(harness.controls) > before and harness.controls[-1][1] == 'duck':
+        p.on_duck_control('pid', p.duck_control_token('pid'), True, issued_at=t)
+
+
+def qualified(p, harness):
+    for i in range(9):
+        feed_at(p, harness, i * .02, VOICE)
+    assert p.command_stream.collector.candidate_frames == 9
+    assert p._duck_hold_until == pytest.approx(.48)
+
+
+def test_owned_qualified_gap_uses_fresh_positive_after_same_ack_clearance(harness):
+    p = reply(harness)
+    qualified(p, harness)
+    token = p.duck_control_token('pid')
+    for i in range(5):
+        feed_at(p, harness, .18 + i * .02, QUIET)
+        assert p._duck_hold_until == pytest.approx(.48)
+        assert p.duck_control_token('pid') == token
+    assert not p._capture_id and p.command_stream.collector.candidate_frames == 9
+    prefix = bytes(p.command_stream.collector.candidate_audio)
+    feed_at(p, harness, .421, VOICE)
+    assert p._capture_id and harness.controls[-1] == ('pid', 'stop')
+    assert bytes(p.command_stream.collector.audio) == prefix + VOICE
+    assert p.command_stream.collector.voiced_frames == 10
+
+
+def test_stale_quiet_does_not_extend_deadline_or_confirm_after_clearance(harness):
+    p = reply(harness)
+    qualified(p, harness)
+    for i in range(17):
+        feed_at(p, harness, .18 + i * .02, QUIET, stamp=0)
+    assert p._duck_hold_until == pytest.approx(.48)
+    assert not p._capture_id and not p.command_stream.collector.candidate_audio
+    assert harness.controls[-1] == ('pid', 'unduck')
+    assert not any(command == 'stop' for _, command in harness.controls)
+
+
+@pytest.mark.parametrize('failure', ['rejected', 'expired'])
+def test_lost_lease_discards_qualified_pending_evidence(harness, failure):
+    p = reply(harness)
+    qualified(p, harness)
+    old = p.duck_control_token('pid')
+    if failure == 'rejected':
+        p.on_duck_control('pid', old, False, issued_at=.16)
+        t = .18
+    else:
