+"""Source-clock/ACK admission only; these fakes do not establish acoustic latency."""
+import ast
+from pathlib import Path
+from queue import Queue
+from threading import Event
+from types import SimpleNamespace
+from time import monotonic
+import pytest
+from malbut_stt.audio import CapturePCM, CaptureSettings, UtteranceCollector
+from malbut_stt.streaming import StreamingUtteranceCollector
+from malbut_stt.echo.recorder import EchoCancelledRecorder
+from test_dialogue_pipeline import harness, VOICE, QUIET
+
+
+def collector(stream=True, minimum=.16):
+    settings=CaptureSettings(min_speech_s=minimum,pre_roll_s=2,silence_timeout_s=2)
+    cls=StreamingUtteranceCollector if stream else UtteranceCollector
+    detector=lambda pcm,rate:any(pcm)
+    return cls(detector,settings=settings) if stream else cls(16000,detector,settings)
+
+
+@pytest.mark.parametrize('stream',[False,True])
+def test_permission_retains_prefix_and_needs_no_second_160ms(stream):
+    c=collector(stream);c.feed(VOICE*8,can_start=False)
+    inner=c.collector if stream else c
+    assert not inner.started and inner.candidate_frames==8
+    prefix=bytes(inner.candidate_audio)
+    c.feed(VOICE,can_start=True)
+    assert inner.started and bytes(inner.audio)==prefix+VOICE
+    assert not inner.start_blocked
+
+
+@pytest.mark.parametrize('stream',[False,True])
+def test_mixed_partial_frame_cannot_inherit_fresh_permission(stream):
+    c=collector(stream,minimum=.02);c.feed(VOICE[:320],can_start=False)
+    c.feed(VOICE[320:],can_start=True)
+    inner=c.collector if stream else c
+    assert not inner.started
+    c.feed(VOICE,can_start=True)
+    assert inner.started and bytes(inner.audio)==VOICE*2
+
+
+@pytest.mark.parametrize('stream',[False,True])
+def test_word_that_ends_before_clearance_is_not_falsely_confirmed(stream):
+    c=collector(stream);c.feed(VOICE*8,can_start=False)
+    c.feed(QUIET*4,can_start=False);c.feed(QUIET,can_start=True)
+    inner=c.collector if stream else c
+    assert not inner.started and not inner.candidate_frames
+    assert VOICE in b''.join(inner.pre_roll)  # Retention is not recognition.
+
+
+def test_denied_confirmation_remains_bounded():
+    c=collector();c.feed(VOICE*250,can_start=False)
+    assert not c.collector.started
+    assert len(c.collector.candidate_audio)<=16000*2*4
+
+
+def test_recorder_preserves_pulse_time_without_changing_waveforms():
+    r=EchoCancelledRecorder.__new__(EchoCancelledRecorder)
+    r._closed=Event();r.aec_ready=True;r._queue=Queue()
+    stamp=monotonic()-.1;r._queue.put(('audio',(VOICE,QUIET,VOICE),stamp))
+    pcm=r.read()
+    assert pcm==VOICE and pcm.vad_pcm==QUIET and pcm.recovery_pcm==VOICE
+    assert pcm.source_timestamp==stamp
+
+
+def reply(harness,**options):
+    p=harness.create(aec=True,barge_in_mode='reachy',
+        settings=CaptureSettings(min_speech_s=.16,silence_timeout_s=2),**options)
+    p._publish_transcript('old','question');p.on_playback_status('pid','playing',request_id='old')
+    return p
+
+
+def audio(harness,pcm=VOICE,stamp=None):
+    return CapturePCM(pcm,pcm,source_timestamp=harness.now if stamp is None else stamp)
+
+
+def test_no_ack_or_stale_source_can_start_despite_elapsed_wall_time(harness):
