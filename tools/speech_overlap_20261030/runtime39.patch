+    p.on_duck_control('pid',token,True,issued_at=harness.now)
+    assert p._duck_clear_after is None and not p._barge_start_allowed(audio(harness,stamp=100))
+
+
+def node_publisher(p,harness,ready=True):
+    source=Path(__file__).parents[1]/'code/malbut_stt/node.py'
+    function=next(n for n in ast.walk(ast.parse(source.read_text())) if isinstance(n,ast.FunctionDef) and n.name=='publish_control')
+    futures=[];removed=[];logs=[]
+    class Future:
+        def add_done_callback(self,cb):self.callback=cb
+        def result(self):return SimpleNamespace(accepted=self.accepted)
+        def resolve(self,accepted):self.accepted=accepted;self.callback(self)
+    def request(_):f=Future();futures.append(f);return f
+    client=SimpleNamespace(service_is_ready=lambda:ready,call_async=request,remove_pending_request=removed.append)
+    logger=SimpleNamespace(warning=logs.append,info=logs.append)
+    ns=dict(pipeline=p,rclpy=SimpleNamespace(ok=lambda:True),requests_closed=False,control_client=client,
+        control_pending={},control_timeout=.5,control_commands={'duck':1,'unduck':2,'stop':3},
+        ControlSpeechPlayback=SimpleNamespace(Request=lambda **kw:kw),monotonic=lambda:harness.now,
+        node=SimpleNamespace(get_logger=lambda:logger))
+    exec(compile(ast.Module(body=[function],type_ignores=[]),str(source),'exec'),ns)
+    return ns['publish_control'],futures
+
+
+@pytest.mark.parametrize('outcome',['accepted','rejected','late','expired_lease','unavailable','old_cycle'])
+def test_actual_node_callback_arms_only_current_success(harness,outcome):
