+def run(tmp_path, traced):
+    api,devices=fake_device();base=api.OutputStream
+    def device(**options):
+        callback=options['callback'];clock=[10.]
+        def timed(out,frames,unused,status):
+            timing=SimpleNamespace(currentTime=clock[0],outputBufferDacTime=clock[0]+.2)
+            clock[0]+=frames/24000
+            with patch('builtins.open',side_effect=AssertionError('callback IO')),patch.object(Path,'open',side_effect=AssertionError('callback IO')):
+                callback(out,frames,timing,status)
+        options['callback']=timed;result=base(**options)
+        result.device=7;result.latency=.2;result.samplerate=24000
+        return result
+    api.OutputStream=device;api.query_devices=lambda i:dict(name='pulse',hostapi=1)
+    api.query_hostapis=lambda i:dict(name='ALSA')
+    states=[];ended=[];source=np.arange(1,17,dtype=np.float32)/32;wall=[10.]
+    with patch.dict('sys.modules',{'sounddevice':api}),patch('malbut_tts.audio.monotonic',lambda:wall[0]):
+        p=StreamingPlayer(states.append,Event(),device='pulse')
+        try:
+            if traced:p.enable_output_trace(tmp_path,'pid','rid','fixture')
+            p.write(source[:12],24000);wait_until(lambda:states==['playing'])
+            d=devices[0];d.step(frames=4)
+            wall[0]=10.201;d.step(frames=4)
+            assert p.set_ducked(True);d.step(frames=4,underflow=True);assert p.set_ducked(False)
+            assert p.pause();d.step(frames=4);d.drain();wait_until(lambda:states[-1]=='paused')
+            assert p.resume();wait_until(lambda:states==['playing','paused','playing'])
+            p.write(source[12:],24000)
+            thread=Thread(target=lambda:(p.finish(),ended.append(True)));thread.start()
+            wait_until(lambda:p._input_done);d.step(frames=12);d.drain();thread.join(2)
+            assert ended==[True] and not thread.is_alive()
+            p.close();assert not list(tmp_path.glob('*'))
+            p.flush_output_trace('finished')
+            return states,d.output,p.underruns,source
+        finally:p.close()
