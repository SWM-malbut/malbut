+"""One owner-thread reopen before any source consumption; no real audio."""
+from contextlib import contextmanager
+from threading import Event, Thread
+from unittest.mock import patch
+import time
+import numpy as np
+import pytest
+from malbut_tts.audio import PlaybackCancelled, StreamingPlayer
+from test_audio import fake_device, wait_until
+
+
+@contextmanager
+def running(tmp_path, close_hook=None, start_hook=None):
+    api,devices=fake_device();api.OutputStream.latency=.035
+    now=[1.];states=[];cancel=Event()
+    original_close=api.OutputStream.close;original_start=api.OutputStream.start
+    def close(d,*args,**kwargs):
+        if close_hook is not None:close_hook(d,devices)
+        original_close(d,*args,**kwargs)
+    def start(d):
+        if start_hook is not None:start_hook(d,devices)
+        original_start(d)
+    api.OutputStream.close=close;api.OutputStream.start=start
+    with patch.dict('sys.modules',{'sounddevice':api}),patch('malbut_tts.audio.monotonic',lambda:now[0]):
+        p=StreamingPlayer(states.append,cancel);p.enable_output_trace(tmp_path,'pid','rid','')
+        p.write(np.arange(1,17,dtype=np.float32),24000)
+        try:
+            wait_until(lambda:states or p._done.is_set())
+            yield p,devices,now,states
+        finally:
+            try:p.close()
+            except RuntimeError:pass
+
+
+def expire(p,devices,now,callback=True):
+    now[0]=p._startup_deadline+.001
+    if callback:devices[-1].step()
+    wait_until(lambda:len(devices)==2 or p._done.is_set())
+    if len(devices)==2:wait_until(lambda:devices[-1].active or p._done.is_set())
+
+
+def finish_in_thread(p):
+    result=[]
+    def run():
+        try:p.finish();result.append('finished')
+        except BaseException as error:result.append(error)
+    t=Thread(target=run);t.start();wait_until(lambda:p._input_done or result)
+    return t,result
+
+
+def test_113_priming_callbacks_then_one_reopen_preserves_full_prefix_and_finish(tmp_path):
+    with running(tmp_path) as (p,devices,now,states):
+        t,result=finish_in_thread(p)
+        first=devices[0]
+        for i in range(113):
+            now[0]=1.+i*.249/112
+            first.step(underflow=i%5!=0)
+        assert p._trace.row_count==113 and p._trace.device_underflows==90
+        assert p._trace.consumed==0 and p._offset==0 and p._input_done
+        expire(p,devices,now)
+        assert first.closed and first.aborted and p._error is None and states==['playing']
+        assert p._startup_retried and p._input_done
+        now[0]+=.036;devices[1].step(frames=32);devices[1].drain();t.join(2)
+        assert result==['finished'] and p._complete
+        assert devices[1].output==list(map(float,range(1,17)))+[0.]*16
+        assert p._trace.consumed==16
+        assert [x['startup_attempt'] for x in p._trace.info['starts']]==[1,2]
+        assert [x['internal_retry'] for x in p._trace.info['starts']]==[False,True]
+        assert p._trace.info['startup_retry']['cause']=='startup_unsettled_250ms_before_source'
+
+
+@pytest.mark.parametrize('callback',[True,False])
+def test_callback_and_owner_timeouts_share_one_retry_then_fail(tmp_path,callback):
+    with running(tmp_path) as (p,devices,now,states):
+        expire(p,devices,now,callback)
+        assert len(devices)==2 and p._error is None
+        now[0]=p._startup_deadline+.001
+        if callback:devices[-1].step()
+        wait_until(p._done.is_set)
+        assert len(devices)==2 and p._trace.consumed==0 and not p._complete
+        assert '250 ms' in str(p._error) and states==['playing']
+        assert all(d.closed for d in devices)
+
+
+def test_old_callbacks_during_close_cannot_consume_or_publish_fatal_error(tmp_path):
+    observed=[];player=[]
+    def closing(d,devices):
+        if d is devices[0]:
+            p=player[0]
+            assert p._startup_retry_requested and not p._startup_retried
+            # Even a now-settled old callback must remain zero/abort.
+            p._startup_ready_at=0.;p._startup_deadline=10.
+            block=np.full((4,1),9.,np.float32)
+            with pytest.raises(p._sd.CallbackAbort):p._callback(block,4,None,None)
+            observed.append(block.copy())
+            assert p._error is None and p._offset==0 and p._trace.consumed==0
+    with running(tmp_path,close_hook=closing) as (p,devices,now,_):
+        player.append(p);expire(p,devices,now)
+        assert observed and np.array_equal(observed[0],np.zeros((4,1)))
+        assert p._error is None and p._startup_retried
+
+
+@pytest.mark.parametrize('action',['stop','close','pause'])
+def test_control_during_close_prevents_replacement_until_allowed(tmp_path,action):
+    entered=Event();release=Event()
+    def closing(d,devices):
+        if d is devices[0]:entered.set();assert release.wait(2)
+    with running(tmp_path,close_hook=closing) as (p,devices,now,states):
+        now[0]=p._startup_deadline+.001;devices[0].step();assert entered.wait(1)
+        if action=='pause':
+            assert p.pause();release.set();wait_until(lambda:states[-1]=='paused')
+            assert len(devices)==1 and p._trace.consumed==0 and p._startup_retried
+            time.sleep(.06);assert len(devices)==1
+            assert p.resume();wait_until(lambda:len(devices)==2 and devices[1].active)
+            assert states==['playing','paused','playing']
+            now[0]=p._startup_deadline+.001;devices[1].step();wait_until(p._done.is_set)
+            assert len(devices)==2 and p._error is not None
+        else:
+            result=[]
+            t=Thread(target=lambda:(getattr(p,action)(),result.append('closed')));t.start()
+            wait_until(p._closing.is_set);release.set();t.join(2)
+            assert result==['closed'] and p._done.is_set() and len(devices)==1
+            assert p._trace.consumed==0
+
+
+def test_source_consumption_permanently_forbids_retry_even_after_pause(tmp_path):
+    with running(tmp_path) as (p,devices,now,states):
+        now[0]+=.036;devices[0].step();assert p._trace.consumed==4
+        assert p.pause();devices[0].step();devices[0].drain();wait_until(lambda:states[-1]=='paused')
+        now[0]+=1;assert p.resume();wait_until(lambda:states[-1]=='playing')
+        devices[0].step(underflow=True)
+        assert len(devices)==1 and p._trace.consumed==8 and not p._startup_pending
+        assert not p._startup_retried and devices[0].output[:4]==[1.,2.,3.,4.]
+        assert devices[0].output[-4:]==[5.,6.,7.,8.]
+
+
+@pytest.mark.parametrize('stage',['start','close'])
+def test_generic_device_errors_remain_fatal_without_recovery(tmp_path,stage):
+    def fail_start(d,devices):raise RuntimeError('native start failed')
+    closes=[]
+    def fail_close(d,devices):
+        closes.append(d);raise RuntimeError('native close failed')
+    with running(tmp_path,start_hook=fail_start if stage=='start' else None,
+                 close_hook=fail_close if stage=='close' else None) as (p,devices,now,states):
+        if stage=='close':now[0]=p._startup_deadline+.001;devices[0].step()
+        wait_until(p._done.is_set)
+        assert len(devices)==1 and 'native '+stage+' failed' in str(p._error)
+        assert p._trace.consumed==0 and not p._complete
+        if stage=='close':assert len(closes)==1
+
+
+def test_producer_write_and_finish_during_old_close_keep_queue_and_done(tmp_path):
+    entered=Event();release=Event()
+    def closing(d,devices):
+        if d is devices[0]:entered.set();assert release.wait(2)
+    with running(tmp_path,close_hook=closing) as (p,devices,now,states):
+        now[0]=p._startup_deadline+.001;devices[0].step();assert entered.wait(1)
+        p.write(np.arange(17,33,dtype=np.float32),24000)
+        t,result=finish_in_thread(p)
+        assert p._error is None and p._input_done and p._offset==0
+        release.set();wait_until(lambda:len(devices)==2 and devices[1].active)
+        now[0]+=.036;devices[1].step(frames=32);devices[1].drain();t.join(2)
+        assert result==['finished'] and devices[1].output==list(map(float,range(1,33)))
+        assert p._trace.consumed==p._trace.source_count==32 and states==['playing']
+
+
+def test_failed_abort_is_fatal_and_not_attempted_twice(tmp_path):
+    with running(tmp_path) as (p,devices,now,states):
+        calls=[]
+        def fail_abort(*args,**kwargs):calls.append(True);raise RuntimeError('native abort failed')
+        devices[0].abort=fail_abort
+        now[0]=p._startup_deadline+.001;devices[0].step();wait_until(p._done.is_set)
+        assert calls==[True] and len(devices)==1 and devices[0].closed
+        assert 'native abort failed' in str(p._error) and p._trace.consumed==0
