+    p.on_duck_control('pid',new,True,issued_at=.6)
+    assert p._duck_clear_after==pytest.approx(.728)
+    # The expired gain cycle's candidate is retired; earn fresh contiguous voice.
+    assert p.command_stream.collector.candidate_frames == 8
+    for t in [.62,.64,.66,.68,.70,.72]:
+        harness.now=t;p.feed(audio(harness))
