+"""PCM/state equivalence for the three bounded runtime12 compute changes."""
+import importlib.util
+from pathlib import Path
+import sys
+from types import SimpleNamespace
+import numpy as np
+import pytest
+
+CANDIDATE=Path(__file__).resolve().parents[1]
+BASELINE=CANDIDATE.parent/'spatial_runtime11'
+
+
+def load(root, file, name):
+    spec=importlib.util.spec_from_file_location('malbut_stt.echo.'+name,root/'code/malbut_stt/echo'/file)
+    module=importlib.util.module_from_spec(spec);spec.loader.exec_module(module);return module
+
+
+def pcm(x):return (x*32768).clip(-32768,32767).astype('<i2').tobytes()
+
+
+@pytest.mark.parametrize('block',[128,512,1024])
+def test_recovery_plateaus_fades_and_restarts_preserve_pcm_and_state(block):
+    old=load(BASELINE,'quiet_asr.py','old_quiet').QuietAsrRecovery()
+    new=load(CANDIDATE,'quiet_asr.py','new_quiet').QuietAsrRecovery()
+    rng=np.random.default_rng(20261029)
+    n=128*250
+    near=rng.uniform(-1.1,1.1,n).astype('f4');raw=rng.uniform(-.04,.04,n).astype('f4')
+    # Finite edges, including both signed zeros and subnormals.
+    near[:8]=[0.,-0.,np.nextafter(np.float32(0),np.float32(1)),np.nextafter(np.float32(0),np.float32(-1)),.98,-.98,1.,-1.]
+    far=np.zeros(n,'f4');far[:128*8]=.1;far[128*50:128*68]=.2;far[128*130:128*134]=.1
+    for start in range(0,n,block):
+        args=(near[start:start+block],raw[start:start+block],far[start:start+block])
+        a=old.process(*args);b=new.process(*args)
+        assert pcm(a)==pcm(b) and np.array_equal(a,b)
+        assert old.quiet_samples==new.quiet_samples and old.blend==new.blend
+        assert np.array_equal(old.raw_delay,new.raw_delay)
+
+
+def test_plateau_avoids_linspace_but_crossfade_uses_original_path(monkeypatch):
+    cls=load(CANDIDATE,'quiet_asr.py','quiet_count').QuietAsrRecovery
+    c=cls();calls=[];original=np.linspace
+    monkeypatch.setattr(np,'linspace',lambda *a,**k:(calls.append(a),original(*a,**k))[1])
+    spatial=np.full(512,.02,'f4');raw=np.full(512,.001,'f4');far=np.full(512,.1,'f4')
+    c.process(spatial,raw,far);assert not calls
+    for _ in range(12):c.process(spatial,raw,np.zeros(512,'f4'))
+    assert len(calls)==5 and c.blend==1
+    count=len(calls)
+    c.process(spatial,raw,np.zeros(512,'f4'));assert len(calls)==count
+    c.process(spatial,raw,far);assert len(calls)==count and c.blend==0
+
+
+def test_discarded_neural_result_does_not_affect_any_exposed_pcm(monkeypatch):
+    class AEC:
+        def __init__(self,**kwargs):pass
+        def process(self,near,far):return near*.25
+    class Neural:
+        def __init__(self,*a):self.calls=0;self.resets=0
+        def reset(self):self.resets+=1
+        def process(self,near,far):self.calls+=1;return np.full_like(near,12345.)
+    monkeypatch.setitem(sys.modules,'pywebrtc_audio',SimpleNamespace(AudioProcessor=AEC))
+    monkeypatch.setitem(sys.modules,'malbut_stt.echo.neural',SimpleNamespace(DTLN=Neural))
+    old=load(BASELINE,'processor.py','old_processor').EchoProcessor(2.,'unused')
+    new=load(CANDIDATE,'processor.py','new_processor').EchoProcessor(2.,'unused')
+    rng=np.random.default_rng(12)
+    for i in range(140):
+        near=rng.normal(0,.01,512).astype('f4');far=np.full(512,.2 if i<20 or i>=100 else 0,'f4')
+        a=old.process_array(near,far);b=new.process_array(near,far)
+        assert a.tobytes()==b.tobytes()
+        assert old.asr_output.tobytes()==new.asr_output.tobytes()
+        assert old.recovery_output.tobytes()==new.recovery_output.tobytes()
+        assert old.reference_hold==new.reference_hold and old.active==new.active
+        for name in ('dry','mic','ref','output','far_delay','voice_delay'):
+            assert getattr(old,name).tobytes()==getattr(new,name).tobytes()
