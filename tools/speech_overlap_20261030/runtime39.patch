+def run_worker(monkeypatch, directory, root, recording, phase_delays=(0,0,0,0,0,0), phase_error=False):
+    worker = load_worker(root, 'worker_' + root.name + str(recording))
+    directory.mkdir()
+    clock = SimpleNamespace(now=0.)
+    stopped = Event()
+    received = []
+    class PhaseClient:
+        def __init__(self, *args): pass
+        def arm(self, *args): pass
+        def select(self, timing, reference, probe, profiles):
+            if phase_error: raise ValueError('forced phase rejection')
+            return dict(delays=list(phase_delays), boundary=160037, corrected_training=np.zeros(32000,'f4'),
+                        training_interval=(0,32000), evidence={})
+        def close(self): pass
+
+    class Stream:
+        def __init__(self, *args, **kwargs): pass
+        def start(self): pass
+        def abort(self): pass
+        def close(self): pass
+        def write(self, pcm): pass
+        def __enter__(self): return self
+        def __exit__(self, *args): pass
+
+    class Thread:
+        def __init__(self, target, **kwargs): self.target = target
+        def start(self):
+            if self.target.__name__ == 'play_calibration': self.target()
+        def join(self, **kwargs): pass
+
+    class Queue:
+        def __init__(self, **kwargs): self.index = 0
+        def get(self, **kwargs):
+            index, phase = divmod(self.index, 2)
+            self.index += 1
+            assert index < 500, 'Worker did not publish and stop'
+            clock.now = .1 + index * .032
+            wave = np.sin((np.arange(512) + index * 512) * .08).astype('f4') * .01
+            if phase == 0: return 'ref', index, wave * .2, clock.now
+            return 'mic', index, np.column_stack((wave, wave * .1)), clock.now
+
+    class Processor:
+        def __init__(self, **kwargs): self.delay = np.zeros(512, 'f4')
+        def process_array(self, near, far):
+            self.recovery_output = np.concatenate((self.delay, near))[:len(near)]
+            self.delay = near[-512:].copy()
+            self.asr_output = near * .5
+            return self.asr_output
+
+    class Output:
+        def put(self, value, **kwargs):
+            received.append(value)
+            if sum(v[0] == 'audio' for v in received) == 8: stopped.set()
+
+    def listing(command, **kwargs):
+        return json.dumps({'sources': [{'name': 'microphone'}],
+                           'sinks': [{'name': 'speaker', 'index': 1}],
+                           'sink-inputs': []}[command[-1]])
+
+    original_load = np.load
+    def load(path, *args, **kwargs):
+        if str(path) == '/tmp/malbut_overlap_mac_20261028/diverse_spatial/leakage.npy':
+            path = root / 'leakage.npy'
+        return original_load(path, *args, **kwargs)
+
+    with monkeypatch.context() as m:
+        gate_path=root/'code/malbut_stt/echo/spatial_echo_gate.py'
+        spec=importlib.util.spec_from_file_location('gate_'+root.name,gate_path)
+        gate=importlib.util.module_from_spec(spec);spec.loader.exec_module(gate)
+        m.setitem(sys.modules,'malbut_stt.echo.spatial_echo_gate',gate)
+        m.setenv('MALBUT_SPATIAL_PHASE_DIR', str(directory))
+        m.setitem(sys.modules, 'malbut_stt.echo.startup_phase', SimpleNamespace(PhaseClient=PhaseClient))
+        if recording: m.setenv('MALBUT_RETEST_RECORD_PREFIX', str(directory / 'capture'))
+        else: m.delenv('MALBUT_RETEST_RECORD_PREFIX', raising=False)
+        m.setitem(sys.modules, 'sounddevice', SimpleNamespace(OutputStream=Stream))
+        m.setitem(sys.modules, 'malbut_stt.echo.pulse', SimpleNamespace(Capture=None))
+        m.setitem(sys.modules, 'malbut_stt.echo.processor', SimpleNamespace(
+            EchoProcessor=Processor, calibrate=lambda *args: dict(microphone_gain=1., lag_samples=320,
+            reference_lead_s=.02, reference_delay_s=0.)))
+        m.setattr(worker, 'Thread', Thread); m.setattr(worker, 'Queue', Queue)
+        m.setattr(worker, 'monotonic', lambda: clock.now)
+        m.setattr(worker.subprocess, 'check_output', listing)
+        m.setattr(np, 'load', load)
+        worker.run(dict(source='microphone', sink='speaker',
+            models=str(ROOT / 'backup/releases/aec-20261028/models'),
+            calibration_audio=str(ROOT / 'backup/releases/aec-20261028/calibration.wav')),
+            Output(), stopped)
+    if phase_error:
+        assert any(v[0]=='error' and 'forced phase rejection' in v[1] for v in received)
+        assert not any(v[0] in ('ready','audio') for v in received)
+        return [], sorted(p.name for p in directory.iterdir())
+    assert not [v for v in received if v[0] == 'error'], received
+    pcm = [v[1] for v in received if v[0] == 'audio']
+    assert len(pcm) == 8 and any(any(chunk) for item in pcm for chunk in item)
+    if any(phase_delays):
+        ready = next(v for v in received if v[0] == 'ready')
+        assert ready[2] >= .1 + 313*.032
+        assert all(v[2] >= ready[2] for v in received if v[0] == 'audio')
+    return pcm, sorted(p.name for p in directory.iterdir())
