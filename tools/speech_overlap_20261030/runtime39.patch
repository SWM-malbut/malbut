+"""A 0.15-sample grid span is inclusive; 0.16 remains rejected."""
+from pathlib import Path
+import importlib.util
+import numpy as np
+import pytest
+
+C=Path(__file__).resolve().parents[1]
+R=C.parents[2]
+
+def load(candidate):
+    path=C.with_name(candidate)/'code/malbut_stt/echo/startup_phase_estimator.py'
+    spec=importlib.util.spec_from_file_location(candidate+'_phase',path)
+    module=importlib.util.module_from_spec(spec);spec.loader.exec_module(module)
+    return module
+
+@pytest.mark.parametrize('upper,accepted',[(.35,True),(.36,False)])
+def test_grid_boundary_does_not_expand_the_allowed_span(monkeypatch,tmp_path,upper,accepted):
+    module=load('spatial_runtime23');count=[0]
+    def transfer(raw,render):
+        result=np.ones((257,6),complex)
+        result[:,5]=np.exp(1j*module.OMEGA*(.2 if count[0]==0 else upper))
+        count[0]+=1
+        return result,np.ones((257,6)),np.ones((257,7))
+    monkeypatch.setattr(module,'_transfer',transfer)
+    profiles=tmp_path/'profiles.npz'
+    np.savez(profiles,transfer=np.ones((2,257,6),complex),coherence=np.ones((2,257,6)),
+             mic2_power=np.ones((2,257)),source_cases=[1,2])
+    args=(np.zeros((32000,6),'f4'),np.full(32000,.1,'f4'),profiles)
+    if accepted:
+        result=module.estimate(*args)
+        values=[r['delay'] for r in result['evidence']['comparisons'] if r['channel']==6]
+        assert np.ptp(values)>.15 and round(float(np.ptp(values)),2)==.15
+    else:
+        with pytest.raises(module.PhaseRejected,match='disagrees'):module.estimate(*args)
+
+def test_exact_rejected_capture_reproduces_old_failure_and_passes_boundary_fix():
+    data=np.load(R/'work/live_runtime22_direct_stop1_b1/capture_phase_input.npz')
+    args=(data['raw6'],data['render'],C/'diverse_spatial/phase_reference.npz')
+    old=load('spatial_runtime22')
+    with pytest.raises(old.PhaseRejected,match='disagrees'):old.estimate(*args)
+    new=load('spatial_runtime23');result=new.estimate(*args)
+    assert len(result['delays'])==6
+    values=[r['delay'] for r in result['evidence']['comparisons'] if r['channel']==6]
+    assert np.ptp(values)>.15 and round(float(np.ptp(values)),2)==.15
