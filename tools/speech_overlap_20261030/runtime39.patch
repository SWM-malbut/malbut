+    p.feed(audio(harness,VOICE*8));assert p._duck_clear_after is None
+    if outcome=='unavailable':assert not futures;return
+    f=futures[0]
+    if outcome=='late':harness.now=.501
+    if outcome=='expired_lease':harness.now=.4
+    if outcome=='old_cycle':
+        harness.now=.34;p.feed(audio(harness,QUIET));p.feed(audio(harness,VOICE*8))
+    f.resolve(outcome!='rejected')
+    assert (p._duck_clear_after is not None)==(outcome=='accepted')
+
