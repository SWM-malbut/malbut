+    plain = SuppressedSilenceVad(SileroStreamVad(model=load_pinned_model(R/'models/silero-v6.2.3.onnx')))
+    traced = SuppressedSilenceVad(SileroStreamVad(model=load_pinned_model(R/'models/silero-v6.2.3.onnx')))
+    recorder = DuckIncidentRecorder(tmp_path/'incidents')
+    observe = recorder.wrap_vad(traced.is_speech,kind='command')
+    try:
+        for i in range(0,len(pcm)-639,640):
+            frame = pcm[i:i+640]
+            assert observe(frame,16000) == plain.is_speech(frame,16000)
+            assert traced.vad.probability == plain.vad.probability
+        assert not recorder.directory.exists()
+        assert recorder._buffer_bytes < recorder.max_buffer_bytes
+        recorder.event('barge_duck_armed:'+json.dumps(dict(playback_id='test',cycle=1)))
+    finally:
+        recorder.close()
+    assert recorder.error is None and recorder.last_incident is not None
+    events = [json.loads(x) for x in (recorder.last_incident/'events.jsonl').read_text().splitlines()]
+    windows = [x for x in events if x['event']=='silero_window']
+    assert windows
+    model = load_pinned_model(R/'models/silero-v6.2.3.onnx')
+    for x in windows:
+        model.state = np.frombuffer(base64.b64decode(x['model_state']),'<f4').copy().reshape(2,1,128)
+        model.context = np.frombuffer(base64.b64decode(x['model_context']),'<f4').copy().reshape(1,64)
+        assert model.probability(base64.b64decode(x['pcm_b64'])) == x['probability']
+    assert not any(x['event']=='transcript_published' for x in events)
+
