+"""All-window selection must not vote away conflicts or ignore a weak tail."""
+import numpy as np
+import pytest
+from malbut_stt.echo.startup_phase_estimator import estimate
+from test_startup_phase_estimator import signals
+
+
+def test_one_confident_conflicting_window_rejects_entire_probe(signals):
+    raw, render, path, _ = signals
+    changed = raw.copy()
+    changed[16000:32000,2:] = raw[16001:32001,2:]
+    with pytest.raises(ValueError, match='disagrees'):
+        estimate(changed, render, path)
+
+
+def test_bad_final_tail_is_not_skipped_by_fixed_window_rounding(signals):
+    raw, render, path, _ = signals
+    render = np.concatenate([render, render[:10000]])
+    raw = np.concatenate([raw, raw[:10000]])
+    # These4900samples would fall outside floor(half_length/16000) windows.
+    noise = np.random.default_rng(42).uniform(-.3,.3,4900).astype('f4')
+    raw[-4900:] = noise[:,None] * np.array([.8,1,.7,.9,1.1,.75], 'f4')
+    with pytest.raises(ValueError, match='coherence'):
+        estimate(raw, render, path)
+
+
+def test_one_fractional_window_is_not_ignored(signals):
+    raw, render, path, _ = signals
+    changed = raw.copy()
+    changed[16000:32000,2:] = (raw[16000:32000,2:]+raw[16001:32001,2:])*.5
+    with pytest.raises(ValueError, match='disagrees'):
+        estimate(changed, render, path)
+
+
+@pytest.mark.parametrize('seed', range(10))
+def test_shared_unrelated_noise_cannot_pass_short_window_confidence(signals, seed):
+    _, render, path, _ = signals
+    noise = np.random.default_rng(900+seed).normal(0,.08,len(render)).astype('f4')
+    raw = noise[:,None] * np.array([.8,1,.7,.9,1.1,.75], 'f4')
+    with pytest.raises(ValueError, match='coherence'):
+        estimate(raw, render, path)
