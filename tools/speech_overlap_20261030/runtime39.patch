+def _has_periodic_onset(pcm):
+    """Check the last 80ms of continuous 16kHz ASR audio before first duck."""
+    import numpy as np
+    if len(pcm) < 2560:
+        return False
+    signal = np.frombuffer(pcm[-2560:], dtype='<i2').astype(float)
+    signal -= signal.mean()
+    correlation = np.fft.irfft(abs(np.fft.rfft(signal, 4096)) ** 2, 4096)
+    energy = np.r_[0., np.cumsum(signal * signal)]
+    lags = np.arange(40, 229)
+    norm = np.sqrt(np.maximum(energy[len(signal) - lags] *
+                             (energy[-1] - energy[lags]), 1e-20))
+    # shortcut: voiced onset only; broaden after whispered/unvoiced overlap trials.
+    return bool(np.max(correlation[lags] / norm) >= .5)


