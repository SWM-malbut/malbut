+"""Trial-only bounded evidence for a duck that never reaches transcription."""
+import base64
+import json
+
+from malbut_stt.incident import IncidentRecorder
+
+
+def encoded(value):
+    return base64.b64encode(value).decode('ascii')
+
+
+class DuckIncidentRecorder(IncidentRecorder):
+    def __init__(self, directory, **callbacks):
+        super().__init__(directory, pre_seconds=8, post_seconds=2,
+                         max_buffer_bytes=4*1024*1024, max_bytes=32*1024*1024,
+                         max_entries=6000, contains=['barge_duck_armed'], exact=[],
+                         save_audio=True, **callbacks)
+
+    def audio(self, pcm, **metadata):
+        super().audio(pcm, source_timestamp=getattr(pcm, 'source_timestamp', None),
+                      vad_pcm_b64=encoded(getattr(pcm, 'vad_pcm', pcm)), **metadata)
+
+    def event(self, name, **metadata):
+        super().event(name, **metadata)
+        if name.startswith('barge_duck_armed:') and not self._disabled:
+            try:
+                details = json.loads(name.split(':', 1)[1])
+                record = self._append('duck_trace_trigger', text='barge_duck_armed',
+                    utterance_id='trace:'+details['playback_id']+':'+str(details['cycle']),
+                    details=details, label_is_event_not_transcript=True)
+                if record is not None:
+                    self._trigger(record)
+            except Exception as error:
+                self._fail(error)
+
+    def wrap_vad(self, is_speech, *, kind):
+        wrapper = is_speech.__self__
+        detector = wrapper.vad
+        model = detector.model
+        original_probability, original_reset = model.probability, model.reset
+
+        def probability(pcm):
+            # State at each retained window makes a cropped ring independently replayable.
+            state, context = model.state.tobytes(), model.context.tobytes()
+            result = original_probability(pcm)
+            self.event('silero_window', kind=kind, pcm_b64=encoded(pcm),
+                       model_state=encoded(state), model_context=encoded(context), probability=result)
+            return result
+
+        def model_reset():
+            original_reset()
+            self.event('silero_model_reset', kind=kind)
+
+        model.probability, model.reset = probability, model_reset
+
+        def observed(frame, rate):
+            decision = is_speech(frame, rate)
+            self.event('vad_tick', kind=kind, pcm_b64=encoded(frame), sample_rate=rate,
+                       speech=bool(decision), probability=detector.probability,
+                       window_has_signal=detector.window_has_signal)
+            return decision
+
+        def reset():
+            wrapper.reset()
+            self.event('vad_capture_reset', kind=kind)
+
+        observed.reset = reset
+        return observed
