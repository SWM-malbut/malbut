+        stream.transcribe(pcm(8.24), 16000, speech_end_s=7.44, final=True)
+    assert stream.transcribe(pcm(9.44), 16000, speech_end_s=7.44, final=True) == '같은 전체 문장'
+    assert len(model.calls) == 3
