+    for i in range(6):
+        feed_at(p, harness, t + (i + 1) * .02, VOICE)
+    assert not p._capture_id
+
+
+def test_natural_finish_preserves_pending_pcm_for_followup(harness):
+    p = reply(harness)
+    qualified(p, harness)
+    feed_at(p, harness, .18, QUIET)
