+"""Subqualified noise must not change gain; completed words still earn admission."""
+import pytest
+from test_dialogue_pipeline import harness,VOICE,QUIET
+from test_post_duck_confirmation import reply,audio
+
+
+def tick(p,harness,t,pcm,*,ack=True,stamp=None):
+    harness.now=t;before=len(harness.controls)
+    p.feed(audio(harness,pcm,stamp=stamp))
+    if ack and len(harness.controls)>before and harness.controls[-1][1]=='duck':
+        p.on_duck_control('pid',p.duck_control_token('pid'),True,issued_at=t)
+
+
+@pytest.mark.parametrize('frames',[2,3,4])
+def test_burst_shorter_than100ms_cannot_lower_gain(harness,frames):
+    p=reply(harness)
+    for repeat in range(3):
+        for i in range(frames):tick(p,harness,repeat*.4+i*.02,VOICE)
+        tick(p,harness,repeat*.4+frames*.02,QUIET)
+    assert harness.controls==[] and not p._capture_id
+
+
+def test_completed_160ms_word_survives_owned_ack_and_source_delay(harness):
+    p=reply(harness)
+    for i in range(8):tick(p,harness,i*.02,VOICE)
+    assert harness.controls==[('pid','duck')]
+    for i in range(10):
+        tick(p,harness,.16+i*.02,QUIET)
+        assert not p._capture_id
+    tick(p,harness,.361,QUIET)
+    assert p._capture_id and harness.controls[-1]==('pid','stop')
+    c=p.command_stream.collector
+    assert c.voiced_frames==8
+    assert bytes(c.audio)==VOICE*8+QUIET*11
+
+
+@pytest.mark.parametrize('failure',['no_ack','rejected','stale_source'])
+def test_retention_never_bypasses_ack_source_or_expiry(harness,failure):
+    p=reply(harness)
+    for i in range(8):tick(p,harness,i*.02,VOICE,ack=failure=='stale_source')
+    if failure=='rejected':p.on_duck_control('pid',p.duck_control_token('pid'),False,issued_at=.14)
+    for i in range(20):tick(p,harness,.16+i*.02,QUIET,ack=failure=='stale_source',stamp=0)
+    assert not p._capture_id
+    assert not p.command_stream.collector.candidate_audio
+    assert not any(command=='stop' for _,command in harness.controls)
+
+
+def test_qualified_expiry_restores_gain_without_new_voice_or_lease_extension(harness):
+    p=reply(harness)
+    for i in range(8):tick(p,harness,i*.02,VOICE)
+    deadline=p._duck_hold_until
+    for i in range(20):tick(p,harness,.16+i*.02,QUIET,stamp=0)
+    assert p._duck_hold_until==deadline
+    assert harness.controls[-1]==('pid','unduck') and p._ducked_playback is None
