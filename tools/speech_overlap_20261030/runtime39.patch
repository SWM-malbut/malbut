+    raw = np.r_[np.zeros(lag), far][:size]
+    lags = check(raw, far)
+    assert np.all(abs(lags[-100:] - lag) <= 2), (lag, lags[-10:])
+raw = np.r_[np.zeros(640), far][:size]
+raw[16000:] = far[16000 - 128:size - 128]
