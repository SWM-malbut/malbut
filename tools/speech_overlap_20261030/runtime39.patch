+def test_recording_preserves_actual_model_decisions_and_saves_only_on_duck(tmp_path):
+    pcm = np.fromfile(R/'work/live_runtime29_shortstop_a1/capture_stages.f32', '<f4').reshape(-1,3)
+    a,b = json.loads((R/'reports/runtime30-suppressed-silence-replay.json').read_text())['raw_interval']
