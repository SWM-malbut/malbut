+"""Actual inner bridge loop, fake FIFO only; no transport/model/device access."""
+import ast
+from collections import deque
+import hashlib
+import importlib.util
+from pathlib import Path
+from threading import Event, Lock
+from types import SimpleNamespace
+import numpy as np
+import pytest
+
+HERE=Path(__file__).resolve().parents[1]
+PARENT=HERE.parent/'spatial_runtime38'
+STATE=('weights','window','history','ola','denominator')
+
+
+def load(name,path):
+    spec=importlib.util.spec_from_file_location(name,path)
+    module=importlib.util.module_from_spec(spec);spec.loader.exec_module(module);return module
+
+
+OLD=load('bridge_original38',PARENT/'spatial_filter.py').SpatialFilter
+NEW=load('bridge_batched39',HERE/'spatial_filter.py').SpatialFilter
+PHASE=load('bridge_phase39',HERE/'code/malbut_stt/echo/startup_phase.py')
+WEIGHTS=np.load(HERE/'diverse_spatial/weights.npy')
+
+
+def inner_loop(root):
+    tree=ast.parse((root/'raw_spatial_ring_bridge.py').read_text())
+    loop=next(n for n in ast.walk(tree) if isinstance(n,ast.While) and ast.unparse(n.test)=='len(pending) >= 8192')
+    return compile(ast.Module(body=[loop],type_ignores=[]),str(root/'raw_spatial_ring_bridge.py'),'exec')
+
+
+class Output:
+    def __init__(self):self.blocks=[];self.ready=[]
+    def write(self,value):self.blocks.append(value);return len(value)
+    def __truediv__(self,name):assert name=='bridge-ready';return self
+    def write_text(self,value):self.ready.append(value)
+
+
+def setup(factory,recording):
+    phase=PHASE.PhaseBridge.__new__(PHASE.PhaseBridge)
+    phase.weights=WEIGHTS;phase.filter_factory=factory;phase.failure=None;phase.deadline=float('inf');phase.lock=Lock()
+    phase.previous=np.zeros(6,'<i2');phase.pending=None;phase.delays=None;phase.sealed=False
+    phase.next_frame=0;phase.boundary=None;phase.applied=Event();phase.history=deque(maxlen=3)
+    output=Output()
+    return dict(np=np,processor=factory(WEIGHTS),phase=phase,timing_delay=np.zeros(384,'f4'),
+        target=output,out=output,frames=0,pending=b'',recording=recording,raw_history=deque(maxlen=1875),raw_total=0,
+        time=SimpleNamespace(monotonic=lambda:1.0))
+
+
+@pytest.mark.parametrize('delays',[[0]*6,[0,0,.53,.27,.525,.265],[0,0,1,1,1,1]])
+@pytest.mark.parametrize('recording',[False,True])
+def test_actual_bridge_fifo_bytes_state_timing_and_phase_boundary(delays,recording):
+    raw=np.random.default_rng(39).integers(-32768,32768,(8*512,8),dtype='<i2')
+    scopes=[setup(factory,recording) for factory in (OLD,NEW)]
+    code=[inner_loop(root) for root in (PARENT,HERE)]
+    for index in range(8):
+        for scope,program in zip(scopes,code):
+            if index==3:scope['phase'].pending=delays
+            scope['pending']+=raw[index*512:(index+1)*512].tobytes()
+            if index==7:scope['pending']+=b'partial-tail'
+            exec(program,scope)
+        a,b=scopes
+        assert a['target'].blocks==b['target'].blocks and len(b['target'].blocks)==index+1
+        assert all(len(block)==4096 for block in b['target'].blocks)
+        assert a['pending']==b['pending'] and a['frames']==b['frames']==(index+1)*512
+        assert a['timing_delay'].tobytes()==b['timing_delay'].tobytes()
+        for field in STATE:assert getattr(a['processor'],field).tobytes()==getattr(b['processor'],field).tobytes()
+        for field in ('delays','pending','next_frame','boundary'):assert getattr(a['phase'],field)==getattr(b['phase'],field)
+        assert a['phase'].previous.tobytes()==b['phase'].previous.tobytes()
+        assert a['phase'].applied.is_set()==b['phase'].applied.is_set()
+        assert list(a['raw_history'])==list(b['raw_history']) and a['raw_total']==b['raw_total']
+    assert scopes[1]['target'].ready==['1.0'] and scopes[1]['pending']==b'partial-tail'
+    timing=np.frombuffer(b''.join(scopes[1]['target'].blocks),'<f4').reshape(-1,2)[:,1]
+    expected=np.concatenate((np.zeros(384,'f4'),raw[:-384,1].astype('f4')/32768))
+    assert timing.tobytes()==expected.tobytes()
+
+
+def test_native_proposed_filter_and_legacy_warmup_source_exact():
+    assert hashlib.sha256((HERE/'spatial_filter.py').read_bytes()).hexdigest()=='7deebeea82422ed1d5663f760b7a1814412789d0f08da8292683065521ac0a14'
+    before=ast.parse((PARENT/'spatial_filter.py').read_text());after=ast.parse((HERE/'spatial_filter.py').read_text())
+    for name in ('__init__','process'):
+        a=next(n for n in ast.walk(before) if isinstance(n,ast.FunctionDef) and n.name==name)
+        b=next(n for n in ast.walk(after) if isinstance(n,ast.FunctionDef) and n.name==name)
+        assert ast.dump(a)==ast.dump(b)
+    assert (HERE/'code/malbut_stt/echo/startup_phase.py').read_bytes()==(PARENT/'code/malbut_stt/echo/startup_phase.py').read_bytes()
+
+
+def test_sub512_input_is_retained_without_filtering_or_writing():
+    scope=setup(NEW,False);scope['pending']=b'\0'*8191
+    exec(inner_loop(HERE),scope)
+    assert scope['pending']==b'\0'*8191 and not scope['target'].blocks and scope['frames']==0
+    assert scope['phase'].next_frame==0
