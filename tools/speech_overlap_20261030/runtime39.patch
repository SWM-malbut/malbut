+def filtered(raw, delays):
+    x=_delay(raw,np.zeros(6,'<i2'),delays) if any(delays) else raw.astype('f4')/32768
+    processor=SpatialFilter(_phase_weights(WEIGHTS, delays))
+    return np.concatenate([(processor.process(x[i:i+128])*32).clip(-.98,.98) for i in range(0,len(x),128)])
+
+
+def test_causal_channel_shift_preserves_every_near_sample_and_actual_seed():
+    # Arbitrary near PCM survives the same startup-fixed operation exactly.
+    raw=np.random.default_rng(917).integers(-20000,20000,(1025,6),dtype='<i2')
+    delays=[0,0,0,1,0,1]
+    whole=_delay(raw[1:],raw[0],delays)
+    chunks=np.concatenate([_delay(raw[1:513],raw[0],delays),
+                           _delay(raw[513:],raw[512],delays)])
+    assert np.array_equal(whole,chunks)
+    assert np.array_equal(whole[:,[0,1,2,4]],raw[1:,[0,1,2,4]].astype('f4')/32768)
+    assert np.array_equal(whole[:,[3,5]],raw[:-1,[3,5]].astype('f4')/32768)
+    assert np.array_equal(_delay(raw[1:],raw[0],[0]*6),raw[1:].astype('f4')/32768)
