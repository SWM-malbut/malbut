digraph MalbutConceptualERD {
  graph [
    label="MALBUT · Conceptual ERD — 데이터는 무엇이며 어떻게 연결되는가\nAgent SQLite와 Homecam PostgreSQL은 독립 저장소이며 사용자 식별자 매핑은 아직 없다",
    labelloc=t,
    fontsize=22,
    fontname="DejaVu Sans",
    rankdir=LR,
    compound=true,
    newrank=true,
    bgcolor="#F7F9FC",
    pad=0.38,
    nodesep=0.26,
    ranksep=0.92,
    splines=polyline,
    outputorder=edgesfirst
  ];
  node [
    shape=plain,
    fontname="DejaVu Sans",
    fontsize=8.7
  ];
  edge [
    dir=none,
    fontname="DejaVu Sans",
    fontsize=7.2,
    color="#2368A2",
    fontcolor="#33465C",
    penwidth=1.25
  ];

  legend [
    label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#AAB7C4" BGCOLOR="#FFFFFF">
      <TR><TD COLSPAN="2" BGCOLOR="#E9EEF4"><B>표기법</B></TD></TR>
      <TR><TD><FONT COLOR="#2368A2">━━━━</FONT></TD><TD ALIGN="LEFT">DB가 강제하는 FK</TD></TR>
      <TR><TD><FONT COLOR="#2368A2">┄ ┄ ┄</FONT></TD><TD ALIGN="LEFT">개념 관계 · FK 없음</TD></TR>
      <TR><TD><FONT COLOR="#C62828">┄ GAP ┄</FONT></TD><TD ALIGN="LEFT">미구현 식별자 매핑</TD></TR>
      <TR><TD>PK / FK</TD><TD ALIGN="LEFT">기본키 / 외래키</TD></TR>
      <TR><TD>0..1 / 0..*</TD><TD ALIGN="LEFT">선택적 하나 / 선택적 다수</TD></TR>
    </TABLE>>
  ];

  subgraph cluster_agent {
    label="Agent SQLite · malbut_agent_server\n대화 이력과 장기 기억";
    color="#28856A";
    fontcolor="#174E3F";
    fontsize=13;
    fontname="DejaVu Sans";
    style="rounded,dashed";
    bgcolor="#F2FCF7";
    penwidth=1.4;

    agent_identity [
      shape=oval,
      style="filled,dashed",
      fillcolor="#E8F5E9",
      color="#2E7D32",
      fontcolor="#174E3F",
      label="user_id\n[논리 식별자 · users 테이블 없음]"
    ];

    conversation_sessions [
      URL="../../malbut_agent_server/malbut_agent_server/conversation.py",
      target="_top",
      label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#2F7E68" BGCOLOR="#FFFFFF">
        <TR><TD BGCOLOR="#2F7E68"><FONT COLOR="white"><B>conversation_sessions</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK</B> user_id + conversation_id<BR ALIGN="LEFT"/>session_instance_id · generation<BR ALIGN="LEFT"/>status · revision · expires_at</TD></TR>
      </TABLE>>
    ];
    conversation_turns [
      URL="../../malbut_agent_server/malbut_agent_server/conversation.py",
      target="_top",
      label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#2F7E68" BGCOLOR="#FFFFFF">
        <TR><TD BGCOLOR="#2F7E68"><FONT COLOR="white"><B>conversation_turns</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK</B> user_id + conversation_id<BR ALIGN="LEFT"/>+ generation + turn_id<BR ALIGN="LEFT"/><B>FK</B> user_id + conversation_id<BR ALIGN="LEFT"/>request_id · ordinal · status</TD></TR>
      </TABLE>>
    ];
    conversation_summaries [
      URL="../../malbut_agent_server/malbut_agent_server/conversation.py",
      target="_top",
      label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#2F7E68" BGCOLOR="#FFFFFF">
        <TR><TD BGCOLOR="#2F7E68"><FONT COLOR="white"><B>conversation_summaries</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK</B> user_id + conversation_id<BR ALIGN="LEFT"/>+ session_instance_id + generation<BR ALIGN="LEFT"/><B>FK</B> user_id + conversation_id<BR ALIGN="LEFT"/>summary_id · content · state_json</TD></TR>
      </TABLE>>
    ];
    memories [
      URL="../../malbut_agent_server/malbut_agent_server/memory.py",
      target="_top",
      label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#2F7E68" BGCOLOR="#FFFFFF">
        <TR><TD BGCOLOR="#2F7E68"><FONT COLOR="white"><B>memories</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK</B> id<BR ALIGN="LEFT"/>user_id · kind · content · revision<BR ALIGN="LEFT"/>evidence_conversation_id / turn_id<BR ALIGN="LEFT"/>evidence_session_instance_id / generation</TD></TR>
      </TABLE>>
    ];
    memory_store_state [
      URL="../../malbut_agent_server/malbut_agent_server/memory.py",
      target="_top",
      label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#2F7E68" BGCOLOR="#FFFFFF">
        <TR><TD BGCOLOR="#2F7E68"><FONT COLOR="white"><B>memory_store_state</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK</B> key<BR ALIGN="LEFT"/>revision<BR ALIGN="LEFT"/><I>global_revision singleton</I></TD></TR>
      </TABLE>>
    ];
    memory_user_revisions [
      URL="../../malbut_agent_server/malbut_agent_server/memory.py",
      target="_top",
      label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#2F7E68" BGCOLOR="#FFFFFF">
        <TR><TD BGCOLOR="#2F7E68"><FONT COLOR="white"><B>memory_user_revisions</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK</B> user_id<BR ALIGN="LEFT"/>revision · updated_at</TD></TR>
      </TABLE>>
    ];
    memory_mutation_requests [
      URL="../../malbut_agent_server/malbut_agent_server/memory.py",
      target="_top",
      label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#2F7E68" BGCOLOR="#FFFFFF">
        <TR><TD BGCOLOR="#2F7E68"><FONT COLOR="white"><B>memory_mutation_requests</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK</B> user_id + request_id<BR ALIGN="LEFT"/>operation · request_fingerprint<BR ALIGN="LEFT"/>response_json · evidence_* fields</TD></TR>
      </TABLE>>
    ];
    memory_audit_events [
      URL="../../malbut_agent_server/malbut_agent_server/memory.py",
      target="_top",
      label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#2F7E68" BGCOLOR="#FFFFFF">
        <TR><TD BGCOLOR="#2F7E68"><FONT COLOR="white"><B>memory_audit_events</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK</B> event_id<BR ALIGN="LEFT"/>user_id · memory_id · request_id<BR ALIGN="LEFT"/>operation · revisions · evidence_* fields</TD></TR>
      </TABLE>>
    ];
    memory_schema_metadata [
      URL="../../malbut_agent_server/malbut_agent_server/memory.py",
      target="_top",
      label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#2F7E68" BGCOLOR="#FFFFFF">
        <TR><TD BGCOLOR="#2F7E68"><FONT COLOR="white"><B>memory_schema_metadata</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK</B> singleton = 1<BR ALIGN="LEFT"/>schema_version<BR ALIGN="LEFT"/>min/max_writer_protocol</TD></TR>
      </TABLE>>
    ];

    conversation_sessions -> conversation_turns [label="1  —  0..*\nFK · ON DELETE CASCADE"];
    conversation_sessions -> conversation_summaries [label="1  —  0..*\nFK · 세대별 최대 1\nON DELETE CASCADE"];

    agent_identity -> conversation_sessions [style=dashed, label="1  —  0..*\nuser_id"];
    agent_identity -> memories [style=dashed, label="1  —  0..*\nuser_id"];
    agent_identity -> memory_user_revisions [style=dashed, label="1  —  0..1\nuser_id"];
    agent_identity -> memory_mutation_requests [style=dashed, label="1  —  0..*\nuser_id"];
    agent_identity -> memory_audit_events [style=dashed, label="1  —  0..*\nuser_id"];

    conversation_turns -> memories [style=dashed, label="0..1  —  0..*\nevidence_* · FK 없음"];
    conversation_turns -> memory_audit_events [style=dashed, label="0..1  —  0..*\nevidence_* · FK 없음"];
    conversation_turns -> memory_mutation_requests [style=dashed, label="0..1  —  0..*\nevidence_* · FK 없음"];
    memories -> memory_audit_events [style=dashed, label="0..1  —  0..*\nmemory_id · FK 없음"];
    memory_mutation_requests -> memory_audit_events [style=dashed, label="0..1  —  0..*\nuser_id + request_id · FK 없음"];
  }

  subgraph cluster_homecam {
    label="Homecam PostgreSQL · 별도 homecam_web 저장소\n장치·스트림·이벤트·접근 제어";
    color="#9E6AAB";
    fontcolor="#593463";
    fontsize=13;
    fontname="DejaVu Sans";
    style="rounded,dashed";
    bgcolor="#FCF7FD";
    penwidth=1.4;

    homecam_identity [
      shape=oval,
      style="filled,dashed",
      fillcolor="#F3E5F5",
      color="#7B3F8C",
      fontcolor="#593463",
      label="user_email / cognito_sub / actor_id / started_by\n[논리 식별자 필드 · users 테이블 없음]"
    ];

    web_auth_sessions [
      label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#7B3F8C" BGCOLOR="#FFFFFF">
        <TR><TD BGCOLOR="#7B3F8C"><FONT COLOR="white"><B>web_auth_sessions</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK</B> token_digest<BR ALIGN="LEFT"/>cognito_sub · cognito_username · user_email<BR ALIGN="LEFT"/>expires_at · revoked_at</TD></TR>
      </TABLE>>
    ];
    web_auth_challenges [
      label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#7B3F8C" BGCOLOR="#FFFFFF">
        <TR><TD BGCOLOR="#7B3F8C"><FONT COLOR="white"><B>web_auth_challenges</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK</B> token_digest<BR ALIGN="LEFT"/>cognito_username · challenge_name<BR ALIGN="LEFT"/>expires_at · claimed_at · consumed_at</TD></TR>
      </TABLE>>
    ];

    devices [
      label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#7B3F8C" BGCOLOR="#FFFFFF">
        <TR><TD BGCOLOR="#7B3F8C"><FONT COLOR="white"><B>devices</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK</B> id<BR ALIGN="LEFT"/>display_name · kvs_channel_arn</TD></TR>
      </TABLE>>
    ];
    device_memberships [
      label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#7B3F8C" BGCOLOR="#FFFFFF">
        <TR><TD BGCOLOR="#7B3F8C"><FONT COLOR="white"><B>device_memberships</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK/FK</B> device_id + <B>PK</B> user_email<BR ALIGN="LEFT"/>role</TD></TR>
      </TABLE>>
    ];
    stream_sessions [
      label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#7B3F8C" BGCOLOR="#FFFFFF">
        <TR><TD BGCOLOR="#7B3F8C"><FONT COLOR="white"><B>stream_sessions</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK</B> id · <B>FK</B> device_id<BR ALIGN="LEFT"/>room_code · started_by · status</TD></TR>
      </TABLE>>
    ];
    stream_session_access [
      label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#7B3F8C" BGCOLOR="#FFFFFF">
        <TR><TD BGCOLOR="#7B3F8C"><FONT COLOR="white"><B>stream_session_access</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK/FK</B> session_id<BR ALIGN="LEFT"/>secret_digest · auth_version</TD></TR>
      </TABLE>>
    ];
    recording_sessions [
      label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#7B3F8C" BGCOLOR="#FFFFFF">
        <TR><TD BGCOLOR="#7B3F8C"><FONT COLOR="white"><B>recording_sessions</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK/FK</B> session_id<BR ALIGN="LEFT"/>kvs_stream_arn · started_at · ended_at</TD></TR>
      </TABLE>>
    ];
    request_rate_limits [
      label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#7B3F8C" BGCOLOR="#FFFFFF">
        <TR><TD BGCOLOR="#7B3F8C"><FONT COLOR="white"><B>request_rate_limits</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK</B> rate_key<BR ALIGN="LEFT"/>window_started_at · request_count<BR ALIGN="LEFT"/><I>독립 운영 상태</I></TD></TR>
      </TABLE>>
    ];
    device_credentials [
      label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#7B3F8C" BGCOLOR="#FFFFFF">
        <TR><TD BGCOLOR="#7B3F8C"><FONT COLOR="white"><B>device_credentials</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK</B> id · <B>FK</B> device_id<BR ALIGN="LEFT"/>label · token_digest · revoked_at</TD></TR>
      </TABLE>>
    ];
    device_state [
      label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#7B3F8C" BGCOLOR="#FFFFFF">
        <TR><TD BGCOLOR="#7B3F8C"><FONT COLOR="white"><B>device_state</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK/FK</B> device_id<BR ALIGN="LEFT"/><B>FK (nullable)</B> active_session_id<BR ALIGN="LEFT"/>monitoring/camera/microphone · health</TD></TR>
      </TABLE>>
    ];
    homecam_events [
      label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#7B3F8C" BGCOLOR="#FFFFFF">
        <TR><TD BGCOLOR="#7B3F8C"><FONT COLOR="white"><B>homecam_events</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK</B> id · <B>FK</B> device_id<BR ALIGN="LEFT"/><B>FK (nullable)</B> recording_session_id<BR ALIGN="LEFT"/>event_type · occurred_at · idempotency_key</TD></TR>
      </TABLE>>
    ];
    homecam_push_outbox [
      label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#7B3F8C" BGCOLOR="#FFFFFF">
        <TR><TD BGCOLOR="#7B3F8C"><FONT COLOR="white"><B>homecam_push_outbox</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK/FK</B> event_id · <B>FK</B> device_id<BR ALIGN="LEFT"/>attempt_count · delivered_at</TD></TR>
      </TABLE>>
    ];
    push_subscriptions [
      label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#7B3F8C" BGCOLOR="#FFFFFF">
        <TR><TD BGCOLOR="#7B3F8C"><FONT COLOR="white"><B>push_subscriptions</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK</B> id · <B>FK</B> device_id<BR ALIGN="LEFT"/>user_email · endpoint · revoked_at</TD></TR>
      </TABLE>>
    ];
    access_audit_log [
      label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#7B3F8C" BGCOLOR="#FFFFFF">
        <TR><TD BGCOLOR="#7B3F8C"><FONT COLOR="white"><B>access_audit_log</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK</B> id · <B>FK</B> device_id<BR ALIGN="LEFT"/>actor_type · actor_id · action</TD></TR>
      </TABLE>>
    ];
    talk_leases [
      label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#7B3F8C" BGCOLOR="#FFFFFF">
        <TR><TD BGCOLOR="#7B3F8C"><FONT COLOR="white"><B>talk_leases</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK/FK</B> device_id<BR ALIGN="LEFT"/>lease_id · user_email · client_id · expires_at</TD></TR>
      </TABLE>>
    ];

    devices -> device_memberships [label="1  —  0..*\nFK · CASCADE"];
    devices -> stream_sessions [label="1  —  0..*\nFK · CASCADE"];
    stream_sessions -> stream_session_access [label="1  —  0..1\nPK/FK · CASCADE"];
    stream_sessions -> recording_sessions [label="1  —  0..1\nPK/FK · CASCADE"];
    devices -> device_credentials [label="1  —  0..*\nFK · CASCADE"];
    devices -> device_state [label="1  —  0..1\nPK/FK · CASCADE"];
    stream_sessions -> device_state [label="0..1  —  0..*\nactive_session_id · SET NULL"];
    devices -> homecam_events [label="1  —  0..*\nFK · CASCADE"];
    stream_sessions -> homecam_events [label="0..1  —  0..*\nrecording_session_id · SET NULL"];
    homecam_events -> homecam_push_outbox [label="1  —  0..1\nPK/FK · CASCADE"];
    devices -> homecam_push_outbox [label="1  —  0..*\nFK · CASCADE"];
    devices -> push_subscriptions [label="1  —  0..*\nFK · CASCADE"];
    devices -> access_audit_log [label="1  —  0..*\nFK · CASCADE"];
    devices -> talk_leases [label="1  —  0..1\nPK/FK · CASCADE"];

    homecam_identity -> device_memberships [style=dashed, label="1  —  0..*\nuser_email"];
    homecam_identity -> web_auth_sessions [style=dashed, label="1  —  0..*\nuser_email / cognito_sub"];
    homecam_identity -> web_auth_challenges [style=dashed, label="1  —  0..*\ncognito_username"];
    homecam_identity -> stream_sessions [style=dashed, label="1  —  0..*\nstarted_by"];
    homecam_identity -> push_subscriptions [style=dashed, label="1  —  0..*\nuser_email"];
    homecam_identity -> access_audit_log [style=dashed, label="1  —  0..*\nactor_id"];
    homecam_identity -> talk_leases [style=dashed, label="1  —  0..*\nuser_email"];
  }

  agent_identity -> homecam_identity [
    style=dashed,
    color="#C62828",
    fontcolor="#922222",
    penwidth=2.2,
    label="GAP\nuser_id ↔ user_email 매핑 없음\n두 DB 사이 FK·동기화 없음",
    constraint=true
  ];

  source_note [
    shape=note,
    style=filled,
    fillcolor="#FFF9E8",
    color="#C28A20",
    fontcolor="#5D4517",
    label="Conceptual view\n테이블명·PK/FK는 코드 기준\n표시하지 않은 일반 속성·인덱스가 있음\nHomecam: db/schema.ts + migrations/0002_web_auth_sessions.sql\nAgent: conversation.py + memory.py"
  ];

  { rank=same; legend; source_note; }
}
