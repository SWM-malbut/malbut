digraph MalbutRoomLiveDynamic {
  graph [
    label="MALBUT · Room Live Monitoring — UML-style Dynamic / Sequence View\n현재 offline-safe 경로와 실제 room-live E2E 사이의 경계",
    labelloc=t,
    fontsize=22,
    fontname="DejaVu Sans",
    rankdir=TB,
    compound=true,
    newrank=true,
    bgcolor="#F7F9FC",
    pad=0.38,
    nodesep=0.38,
    ranksep=0.64,
    splines=polyline
  ];
  node [
    shape=box,
    style="rounded,filled",
    fontname="DejaVu Sans",
    fontsize=9.1,
    color="#2368A2",
    fillcolor="#E7F1FA",
    fontcolor="#173A55",
    penwidth=1.35,
    margin="0.14,0.09"
  ];
  edge [
    fontname="DejaVu Sans",
    fontsize=7.8,
    color="#315E82",
    fontcolor="#294C68",
    arrowsize=0.65,
    penwidth=1.2
  ];

  user [
    label="사용자\n[actor]",
    shape=oval,
    fillcolor="#EEE8FC",
    color="#6747C7",
    fontcolor="#4D368F"
  ];

  subgraph cluster_offline {
    label="CURRENT · side-effect-free interaction path";
    color="#3578B7";
    fontcolor="#245884";
    fontsize=11.5;
    fontname="DejaVu Sans";
    style="rounded,dashed";
    bgcolor="#F2F8FD";

    voice [
      label="ContinuousVoiceSession\n[OFFLINE]\nwake-gated final STT\nawaiting_confirmation → mission_wait\nterminal 뒤에만 wake 재무장",
      URL="../../malbut_agent_server/malbut_agent_server/continuous_voice.py",
      target="_top"
    ];
    agent [
      label="Agent Orchestrator\n[RUN · proposal]\nmonitor_room(location)\nexecution.authorized = false",
      fillcolor="#E7F7F1",
      color="#23805E",
      fontcolor="#17523D",
      URL="../../malbut_agent_server/malbut_agent_server/tools.py",
      target="_top"
    ];
    safety [
      label="SafetyPolicy\n[RUN]\nclosed whole-utterance grammar\n+ monitorable Room + trusted state",
      fillcolor="#E7F7F1",
      color="#23805E",
      fontcolor="#17523D",
      URL="../../malbut_agent_server/malbut_agent_server/safety.py",
      target="_top"
    ];
    authority [
      label="RoomMonitoringMission.propose\n[OFFLINE]\nserver authority resolve + current check\nconversation generation/revision 결속",
      fillcolor="#FFF4DE",
      color="#C57A18",
      fontcolor="#5D3909",
      URL="../../malbut_agent_server/malbut_agent_server/room_mission.py",
      target="_top"
    ];
    proposal [
      label="Opaque proposal handle\n[OFFLINE]\nidentity-bound capability\nplan·pose·owner 비노출",
      fillcolor="#FFF4DE",
      color="#C57A18",
      fontcolor="#5D3909",
      URL="../../malbut_agent_server/malbut_agent_server/room_mission.py",
      target="_top"
    ];
    confirm [
      label="명시적 확인 verifier\n[OFFLINE contract]\nuntrusted evidence → TrustedConfirmation\nuser · conversation · decision · args · expiry 결속\nplain bool / 짧은 확인 text 아님",
      shape=diamond,
      fillcolor="#FFF4DE",
      color="#C57A18",
      fontcolor="#5D3909",
      URL="../../malbut_agent_server/malbut_agent_server/room_mission.py",
      target="_top"
    ];
    resolver [
      label="SemanticRoomResolver\n[OFFLINE]\nmap/revision + unique Room 검증\nserver-owned goal + coverage viewpoints",
      URL="../../malbut_agent_server/malbut_agent_server/room_mission.py",
      target="_top"
    ];
    mission [
      label="RoomMonitoringMission.confirm / execute\n[OFFLINE]\nprocess-local consume-once + controller-instance lease\npreflight → navigate → cover → live_ready",
      URL="../../malbut_agent_server/malbut_agent_server/room_mission.py",
      target="_top"
    ];
    simulation [
      label="SimulationRoomMissionAdapter\n[OFFLINE]\nphysical_effects = false\nROS · camera · network I/O 없음",
      URL="../../malbut_agent_server/malbut_agent_server/room_mission.py",
      target="_top"
    ];
    simulated_terminal [
      label="MissionFeedback\nsimulation_succeeded\nsimulated = true · viewer_live = false\n≠ 이동 완료 · ≠ actual live",
      shape=doubleoctagon,
      fillcolor="#FFF4DE",
      color="#C57A18",
      fontcolor="#5D3909",
      penwidth=1.65
    ];

    {
      rank=same;
      user;
      voice;
      agent;
      safety;
    }
    {
      rank=same;
      authority;
      resolver;
      proposal;
      confirm;
    }
    {
      rank=same;
      mission;
      simulation;
      simulated_terminal;
    }
  }

  user -> voice [
    label="① wake word"
  ];
  voice -> agent [
    label="② bound final STT event"
  ];
  agent -> safety [
    label="③ monitor_room 제안"
  ];
  safety -> authority [
    label="④ allowed proposal\n(refuse/clarify면 여기서 종료)",
    color="#23805E",
    fontcolor="#17523D"
  ];
  authority -> resolver [
    label="⑤ current authority"
  ];
  resolver -> proposal [
    label="⑥ immutable semantic plan"
  ];
  proposal -> confirm [
    label="⑦ pending proposal"
  ];
  user -> confirm [
    label="⑧ confirmation evidence\n(untrusted)",
    color="#C57A18",
    fontcolor="#78480B",
    constraint=false
  ];
  confirm -> mission [
    label="⑨ verifier-issued\nTrustedConfirmation"
  ];
  mission -> simulation [
    label="⑩ confirmed Tool ID\n+ bounded fake phases"
  ];
  simulation -> simulated_terminal [
    label="⑪ deterministic result"
  ];

  subgraph cluster_real {
    label="TARGET · physical robot + authenticated web path (not connected)";
    color="#C62828";
    fontcolor="#922222";
    fontsize=11.5;
    fontname="DejaVu Sans";
    style="rounded,dashed";
    bgcolor="#FFF7F7";

    durable [
      label="GAP · Durable authorization ledger\nrestart-safe exactly-once\nconfirmation consume + tool_call_id",
      shape=octagon,
      style="filled,dashed",
      fillcolor="#FFF0F0",
      color="#C62828",
      fontcolor="#922222",
      URL="../../malbut_agent_server/docs/jira/SWM25-78_ROOM_LIVE_MONITORING_SCENARIO.md",
      target="_top"
    ];
    nav2 [
      label="GAP · Trusted Nav2 adapter\nverified goal / coverage Action\nfeedback · cancel · fresh ROS state",
      shape=octagon,
      style="filled,dashed",
      fillcolor="#FFF0F0",
      color="#C62828",
      fontcolor="#922222",
      URL="../../malbut_gazebo/launch/navigation.launch.py",
      target="_top"
    ];
    homecam [
      label="GAP · Homecam status + KVS\nread-only privacy/P2P readiness\ntrusted session callback",
      shape=octagon,
      style="filled,dashed",
      fillcolor="#FFF0F0",
      color="#C62828",
      fontcolor="#922222",
      URL="../../homecam_agent/homecam_media_agent/src/media_agent_node.cpp",
      target="_top"
    ];
    browser [
      label="인증된 Malbut Web viewer\n[EXT / unverified callback]\nviewer_live evidence 없음",
      shape=component,
      fillcolor="#EEF0F3",
      color="#7D8796",
      fontcolor="#505965"
    ];
    feedback_gap [
      label="GAP · Trusted Tool result feedback\nsame conversation durable commit\nresponse/TTS exactly once",
      shape=octagon,
      style="filled,dashed",
      fillcolor="#FFF0F0",
      color="#C62828",
      fontcolor="#922222",
      URL="../../malbut_agent_server/malbut_agent_server/conversation.py",
      target="_top"
    ];

    {
      rank=same;
      durable;
      nav2;
      homecam;
    }
    {
      rank=same;
      browser;
      feedback_gap;
    }

    durable -> nav2 [
      label="authorized plan",
      style=dashed,
      color="#C62828",
      fontcolor="#922222"
    ];
    nav2 -> homecam [
      label="coverage progress",
      style=dashed,
      color="#C62828",
      fontcolor="#922222"
    ];
    homecam -> browser [
      label="P2P live-only media",
      style=dashed,
      color="#C62828",
      fontcolor="#922222"
    ];
    browser -> feedback_gap [
      label="viewer_live callback",
      style=dashed,
      color="#C62828",
      fontcolor="#922222"
    ];
  }

  mission -> durable [
    label="required for physical execution",
    style=dashed,
    color="#C62828",
    fontcolor="#922222",
    arrowhead=tee,
    lhead=cluster_real,
    constraint=false
  ];
  feedback_gap -> voice [
    label="required before spoken feedback",
    style=dashed,
    color="#C62828",
    fontcolor="#922222",
    arrowhead=tee,
    constraint=false
  ];

  simulated_terminal -> durable [
    style=invis,
    weight=50,
    minlen=2
  ];

  legend [
    label="읽는 법\n①–⑪ = 현재 코드가 표현하는 interaction 순서\n초록 RUN = 제안/검증 코드 · 파랑 OFFLINE = side-effect-free core\n빨간 점선 GAP = 실제 연결 없음 · 회색 EXT = 저장소 밖/외부\n\n중요: fake live_ready는 adapter 계약 시험 결과일 뿐이며\nNav2 이동, KVS 송출, 브라우저 frame 표시를 증명하지 않는다.",
    shape=note,
    style=filled,
    fillcolor="#EEF2F7",
    color="#7B8794",
    fontcolor="#33465C",
    fontsize=8.2
  ];
  feedback_gap -> legend [style=invis, weight=20];
}
