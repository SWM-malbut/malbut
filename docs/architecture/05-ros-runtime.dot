digraph MalbutRosRuntime {
  graph [
    label="MALBUT · ROS 2 Runtime Graph — Expected Simulation Topology\nsource-derived view · live rqt_graph capture가 아님",
    labelloc=t,
    fontsize=22,
    fontname="DejaVu Sans",
    rankdir=LR,
    compound=true,
    newrank=true,
    bgcolor="#F7F9FC",
    pad=0.35,
    nodesep=0.34,
    ranksep=0.82,
    splines=polyline
  ];
  node [
    shape=box,
    style="rounded,filled",
    fontname="DejaVu Sans",
    fontsize=9.2,
    color="#2368A2",
    fillcolor="#438DD5",
    fontcolor="white",
    penwidth=1.3,
    margin="0.13,0.08"
  ];
  edge [
    fontname="DejaVu Sans",
    fontsize=7.4,
    color="#53657A",
    fontcolor="#33465C",
    arrowsize=0.62,
    penwidth=1.0
  ];

  subgraph cluster_gazebo {
    label="Simulation boundary · simulation.launch.py";
    color="#C37A1D";
    fontcolor="#6D420C";
    fontsize=11.5;
    fontname="DejaVu Sans";
    style="rounded,dashed";
    bgcolor="#FFF9EF";

    gazebo [
      label="Gazebo Fortress\n[non-ROS simulator]\nphysics · drive · RGB-D · LiDAR · IMU",
      fillcolor="#D88923",
      color="#A65B05",
      URL="../../malbut_gazebo/urdf/gazebo_plugins.xacro",
      target="_top"
    ];
    bridge [
      label="/malbut_bridge\n[ros_gz_bridge node]\nparameter_bridge",
      URL="../../malbut_gazebo/config/bridge.yaml",
      target="_top"
    ];

    gazebo -> bridge [
      dir=both,
      style=dashed,
      color="#9A6A2F",
      fontcolor="#6D420C",
      label="Gazebo Transport\n(non-ROS)"
    ];
  }

  // ROS topics are ellipses. They deliberately sit outside process clusters.
  node [
    shape=ellipse,
    style=filled,
    fillcolor="#FFFFFF",
    color="#2473A7",
    fontcolor="#173A55",
    penwidth=1.2,
    margin="0.10,0.05"
  ];
  t_clock [label="/clock"];
  t_joint [label="/joint_states"];
  t_odom [label="/odom"];
  t_scan [label="/scan"];
  t_image [label="/camera/color/\nimage_raw"];
  t_info [label="/camera/color/\ncamera_info"];
  t_tf [label="/tf\n/tf_static"];
  t_map [label="/map"];
  t_cmd [label="/cmd_vel"];
  t_monitoring [label="/homecam/\nmonitoring_enabled"];
  t_health [label="/homecam/\ndetector_healthy"];

  subgraph primary_topics {
    rank=same;
    t_clock;
    t_joint;
    t_odom;
    t_scan;
    t_image;
    t_info;
  }
  subgraph derived_topics {
    rank=same;
    t_tf;
    t_map;
    t_cmd;
    t_monitoring;
    t_health;
  }

  // Reset the default for actual ROS nodes.
  node [
    shape=box,
    style="rounded,filled",
    color="#2368A2",
    fillcolor="#438DD5",
    fontcolor="white",
    penwidth=1.3
  ];

  subgraph cluster_navigation {
    label="Robot model · localization · navigation";
    color="#6B83B5";
    fontcolor="#34496F";
    fontsize=11.5;
    fontname="DejaVu Sans";
    style="rounded,dashed";
    bgcolor="#F6F7FC";

    rsp [
      label="/robot_state_publisher\n[ROS node]\nURDF + joints → link TF",
      URL="../../malbut_gazebo/launch/simulation.launch.py",
      target="_top"
    ];
    slam [
      label="/slam_toolbox\n[ROS node · SLAM mode]\nscan → map + map→odom",
      fillcolor="#5D78AE",
      URL="../../malbut_gazebo/launch/slam.launch.py",
      target="_top"
    ];
    localization [
      label="/map_server + /amcl\n[ROS node group · static-map mode]\nmap + scan → map→odom",
      fillcolor="#5D78AE",
      URL="../../malbut_gazebo/launch/navigation.launch.py",
      target="_top"
    ];
    nav2 [
      label="Nav2 server nodes\n[node group]\nBT · planner · controller · costmaps",
      URL="../../malbut_gazebo/config/nav2_params.yaml",
      target="_top"
    ];
    mode_note [
      label="MODE ALTERNATIVE\nSLAM Toolbox\n또는 Map Server + AMCL",
      shape=note,
      style="filled,dashed",
      fillcolor="#FFF4DE",
      color="#C57A18",
      fontcolor="#5D3909",
      fontsize=8.2
    ];

    mode_note -> slam [style=dashed, color="#C57A18", arrowhead=none];
    mode_note -> localization [style=dashed, color="#C57A18", arrowhead=none];
  }

  subgraph cluster_homecam {
    label="Homecam · separate homecam_sim.launch.py · RUN/COND";
    color="#28856A";
    fontcolor="#174E3F";
    fontsize=11.5;
    fontname="DejaVu Sans";
    style="rounded,dashed";
    bgcolor="#F2FCF7";

    media [
      label="/homecam_media_agent\n[ROS node]\nframe ingest · streaming · heartbeat",
      fillcolor="#2B8C70",
      color="#176049",
      URL="../../homecam_agent/homecam_media_agent/src/media_agent_node.cpp",
      target="_top"
    ];
    detector [
      label="/homecam_detector\n[ROS node]\nread-only motion · YOLO · event",
      fillcolor="#2B8C70",
      color="#176049",
      URL="../../homecam_agent/homecam_detector/homecam_detector/detector_node.py",
      target="_top"
    ];
  }

  subgraph runtime_nodes {
    rank=same;
    rsp;
    slam;
    localization;
    nav2;
    media;
    detector;
  }

  subgraph cluster_agent {
    label="LLM Agent · intentionally outside the ROS graph";
    color="#C62828";
    fontcolor="#922222";
    fontsize=11.5;
    fontname="DejaVu Sans";
    style="rounded,dashed";
    bgcolor="#FFF7F7";

    agent [
      label="malbut_agent_server\n[non-ROS process]\nproposal + confirmation only",
      fillcolor="#FFFFFF",
      fontcolor="#922222",
      color="#C62828",
      style="rounded,filled,dashed",
      URL="../../malbut_agent_server/README.md",
      target="_top"
    ];
    execution_gap [
      label="GAP\nROS publisher/subscriber·adapter 없음\nexecution.authorized = false\nAgent ↛ Nav2 / Homecam",
      shape=octagon,
      fillcolor="#FFF0F0",
      fontcolor="#922222",
      color="#C62828",
      style="filled,dashed"
    ];
    agent -> execution_gap [
      style=dashed,
      color="#C62828",
      fontcolor="#922222",
      arrowhead=tee,
      label="not connected"
    ];
  }

  scope_note [
    label="읽는 법\nbox = node / node group · ellipse = topic\n실선 = publisher → topic → subscriber\n주황 점선 = launch mode alternative\n회색 점선 = ROS 밖 transport · 빨간 GAP = 없는 연결\n\nlaunch·bridge·node 소스에서 만든 expected graph이며\n실행 순간을 캡처한 rqt_graph 결과가 아니다.\n선택 인자에 따라 node가 달라지고, /imu/data·depth topics·\nRViz·actions/services는 복잡도를 줄이기 위해 생략했다.",
    shape=note,
    style=filled,
    fillcolor="#EEF2F7",
    color="#7B8794",
    fontcolor="#33465C",
    fontsize=8.2
  ];

  // Column 1 → 2: GZ_TO_ROS publishers from bridge.yaml.
  bridge -> t_clock [label="publishes"];
  bridge -> t_joint [label="publishes"];
  bridge -> t_odom [label="publishes"];
  bridge -> t_scan [label="publishes"];
  bridge -> t_image [label="publishes"];
  bridge -> t_info [label="publishes"];
  bridge -> t_tf [label="publishes odom TF", constraint=false];

  // Column 2 → 3 → 4: robot model, localization, navigation.
  t_joint -> rsp [label="subscribes"];
  t_clock -> rsp [label="sim time"];
  rsp -> t_tf [label="publishes link TF"];

  t_clock -> slam [label="sim time"];
  t_scan -> slam [label="subscribes"];
  t_tf -> slam [label="subscribes", constraint=false];
  slam -> t_map [label="publishes"];
  slam -> t_tf [label="publishes map→odom"];

  t_clock -> localization [label="sim time"];
  t_scan -> localization [label="subscribes"];
  t_tf -> localization [label="subscribes", constraint=false];
  localization -> t_map [label="map_server publishes"];
  localization -> t_tf [label="AMCL publishes map→odom"];

  t_clock -> nav2 [label="sim time"];
  t_odom -> nav2 [label="subscribes"];
  t_scan -> nav2 [label="costmaps"];
  t_tf -> nav2 [label="subscribes", constraint=false];
  t_map -> nav2 [label="global costmap", constraint=false];
  nav2 -> t_cmd [label="controller publishes"];
  t_cmd -> bridge [label="subscribes · ROS_TO_GZ", constraint=false];

  // Homecam camera input and privacy/health handshake.
  t_image -> media [label="subscribes"];
  t_info -> media [label="subscribes"];
  t_odom -> media [label="read-only"];
  t_image -> detector [label="subscribes"];
  t_odom -> detector [label="read-only"];
  media -> t_monitoring [label="publishes\nreliable + transient local"];
  t_monitoring -> detector [label="subscribes", constraint=false];
  detector -> t_health [label="publishes\nreliable + transient local"];
  t_health -> media [label="subscribes", constraint=false];

  // Invisible edges establish reading order only; they are not communication.
  execution_gap -> bridge [style=invis, weight=3];
  t_info -> scope_note [style=invis, weight=1];
}
