<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    The Hiwonder wheel meshes use the inner wheel face as their local Y=0.
    Malbut keeps each dynamic wheel frame at the roller envelope centre so the
    joint inertia, collision proxy, and MecanumDrive dimensions share one
    unambiguous convention.
  -->
  <xacro:macro name="mecanum_wheel" params="name mesh x y z mesh_y">
    <link name="${name}_wheel_link">
      <xacro:wheel_y_inertial
        mass="${wheel_mass}"
        radius="${wheel_radius}"
        width="${wheel_width}"/>
      <visual>
        <origin xyz="0 ${mesh_y} 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find malbut_description)/meshes/${mesh}"/>
        </geometry>
        <material name="rosorin_dark"/>
      </visual>
      <!--
        Use a spherical contact proxy for Fortress' directional-friction
        mecanum approximation. The supplied roller-shaped collision meshes are
        preserved in meshes/, but using them as dynamic triangle contacts makes
        lateral motion unstable and is not how Hiwonder's Gazebo package drives
        the robot either.
      -->
      <collision>
        <geometry>
          <sphere radius="${wheel_radius}"/>
        </geometry>
      </collision>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel_link"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics
        damping="${wheel_joint_damping}"
        friction="${wheel_joint_friction}"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="rosorin_mecanum_base">
    <link name="base_footprint"/>

    <link name="base_link">
      <xacro:box_inertial_at
        mass="${base_mass}"
        x="${base_length}"
        y="${base_width}"
        z="${base_height}"
        origin_x="${base_com_x}"
        origin_y="${base_com_y}"
        origin_z="${base_com_z}"/>
      <visual>
        <geometry>
          <mesh filename="file://$(find malbut_description)/meshes/base_link.stl"/>
        </geometry>
        <material name="rosorin_body"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="file://$(find malbut_description)/meshes/base_link_collision.stl"/>
        </geometry>
      </collision>
    </link>

    <joint name="base_footprint_joint" type="fixed">
      <parent link="base_footprint"/>
      <child link="base_link"/>
      <origin xyz="0 0 ${base_footprint_z}" rpy="0 0 0"/>
    </joint>

    <xacro:mecanum_wheel
      name="front_left"
      mesh="left_front_wheel_link.stl"
      x="${wheel_x_offset + wheelbase / 2.0}"
      y="${wheel_y_offset + wheel_separation / 2.0}"
      z="${front_wheel_z}"
      mesh_y="${-wheel_width / 2.0}"/>
    <xacro:mecanum_wheel
      name="front_right"
      mesh="right_front_wheel_link.stl"
      x="${wheel_x_offset + wheelbase / 2.0}"
      y="${wheel_y_offset - wheel_separation / 2.0}"
      z="${front_wheel_z}"
      mesh_y="${wheel_width / 2.0}"/>
    <xacro:mecanum_wheel
      name="rear_left"
      mesh="left_back_wheel_link.stl"
      x="${wheel_x_offset - wheelbase / 2.0}"
      y="${wheel_y_offset + wheel_separation / 2.0}"
      z="${rear_wheel_z}"
      mesh_y="${-wheel_width / 2.0}"/>
    <xacro:mecanum_wheel
      name="rear_right"
      mesh="right_back_wheel_link.stl"
      x="${wheel_x_offset - wheelbase / 2.0}"
      y="${wheel_y_offset - wheel_separation / 2.0}"
      z="${rear_wheel_z}"
      mesh_y="${wheel_width / 2.0}"/>
  </xacro:macro>
</robot>
