<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>malbut_scenarios</name>
  <version>0.1.0</version>
  <description>Integrated autonomous-driving demonstrations for Malbut.</description>
  <maintainer email="sanggeunji0117@gmail.com">SANGGEUN JI</maintainer>
  <license>Apache-2.0</license>

  <depend>action_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>malbut_interfaces</depend>
  <depend>nav_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>malbut_gazebo</exec_depend>
  <exec_depend>malbut_gazebo_plugins</exec_depend>
  <exec_depend>malbut_perception</exec_depend>
  <exec_depend>malbut_roaming</exec_depend>
  <exec_depend>malbut_tracking</exec_depend>
  <exec_depend>nav2_collision_monitor</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rqt_image_view</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
