<?xml version="1.0" encoding="UTF-8"?>
<!-- Camera/vendor hardware only. Allow RGB + depth + 8.2 MB clouds in flight.
     32 MiB leaves headroom without the unhelpful 64 MiB increase in Gazebo.
     Keep remote UDP communication and all endpoint QoS defaults. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>malbut_camera_shm</transport_id>
      <type>SHM</type>
      <segment_size>33554432</segment_size>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>malbut_camera_udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="malbut_camera_default" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>malbut_camera_shm</transport_id>
        <transport_id>malbut_camera_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
