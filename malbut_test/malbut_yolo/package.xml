<?xml version="1.0"?>
<package format="3">
  <name>malbut_yolo</name>
  <version>0.1.0</version>
  <description>Shared upstream yolo_ros detector configuration and timing.</description>
  <maintainer email="sanggeunji0117@gmail.com">Malbut</maintainer>
  <license>GPL-3.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>yolo_ros</exec_depend>
