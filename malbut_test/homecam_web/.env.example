# Local development only. Production uses Cognito server auth and Secrets Manager.
DATABASE_URL=postgresql://homecam:homecam_local_only@127.0.0.1:5432/homecam
# ECS may inject DATABASE_HOST/PORT/NAME/USERNAME/PASSWORD separately instead.
DATABASE_SSL_MODE=disable
# Required with verify-full. The production image contains this pinned AWS bundle.
DATABASE_SSL_CA_FILE=certs/ap-northeast-2-bundle.pem
DATABASE_POOL_MAX=10

AUTH_MODE=dev_header
AUTH_DEV_USER_EMAIL=owner@example.test
AUTH_AWS_REGION=ap-northeast-2
AUTH_PUBLIC_ORIGIN=
AUTH_SIGN_IN_PATH=/auth/login
AUTH_SIGN_OUT_PATH=/auth/logout
COGNITO_USER_POOL_ID=
COGNITO_USER_POOL_CLIENT_ID=
# Local-only 32-byte base64url key. Production generates this in Secrets Manager.
AUTH_SESSION_SECRET=

PETCAM_BROADCASTER_EMAILS=owner@example.test
PETCAM_DEVICE_ID=malbut-sim-01
PETCAM_SHARE_SECRET=

# Each device owns distinct P2P channel, Storage channel, and archive stream.
KVS_DEVICE_CHANNELS_JSON={"malbut-sim-01":{"p2pChannelArn":"arn:aws:kinesisvideo:ap-northeast-2:000000000000:channel/dev-malbut-sim-01-p2p/0000000000000","storageChannelArn":"arn:aws:kinesisvideo:ap-northeast-2:000000000000:channel/dev-malbut-sim-01-storage/0000000000000","streamArn":"arn:aws:kinesisvideo:ap-northeast-2:000000000000:stream/dev-malbut-sim-01-archive/0000000000000"}}
KVS_BROKER_URL=https://example.lambda-url.ap-northeast-2.on.aws/
KVS_BROKER_SECRET=

PUSH_BROKER_URL=https://example.lambda-url.ap-northeast-2.on.aws/
PUSH_BROKER_SECRET=
PUSH_VAPID_PUBLIC_KEY=
MAINTENANCE_SECRET=

# One-time internal provisioning only. Disable after registering the device.
DEVICE_PROVISIONING_SECRET=
DEVICE_PROVISIONING_MANIFEST_SHA256=
DEVICE_PROVISIONING_EXPIRES_AT=
DEVICE_PROVISIONING_LEGACY_DEVICE_ID=
