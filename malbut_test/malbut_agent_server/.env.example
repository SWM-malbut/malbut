MALBUT_AGENT_PROVIDER=mock
# proposal (default, no adapter execution) or explicit local simulation
MALBUT_AGENT_TOOL_MODE=proposal
MALBUT_AGENT_HOST=127.0.0.1
MALBUT_AGENT_PORT=8765
MALBUT_AGENT_DB=/tmp/malbut-agent.sqlite3
MALBUT_AGENT_USER_ID=local-user
MALBUT_AGENT_AUTH_TOKEN=
# Optional/default-OFF RAI sidecar. Select MALBUT_AGENT_PROVIDER=rai-sidecar
# only with a separately managed Python environment; rai-core is deliberately
# not installed into this ROS package. PYTHON must be a dedicated venv's
# bin/python, and CWD must be an absolute directory outside that venv. The
# sidecar receives only its protocol payload and allowlisted variables.
MALBUT_RAI_SIDECAR_PYTHON=
MALBUT_RAI_SIDECAR_CWD=
MALBUT_RAI_SIDECAR_TIMEOUT_SECONDS=5
# Required together with OPENAI_API_KEY when rai-sidecar is selected.
MALBUT_RAI_MODEL=
# SWM25-131 malbut_scenarios composition only. These are server-owned;
# clients cannot send either value in /v1/text/turns.
MALBUT_NAMED_NAVIGATION_MAP_STORE=
MALBUT_ROBOT_DEVICE_ID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Background compression stays on a cheaper model even if conversation changes.
# Explicitly empty values inherit OPENAI_MODEL / OPENAI_REASONING_EFFORT.
OPENAI_SUMMARY_MODEL=gpt-6-luna
OPENAI_SUMMARY_REASONING_EFFORT=low
OPENAI_FALLBACK_MODEL=
# Optional role models. They are used only with an explicit Front Router.
# If both are empty, all routes keep using OPENAI_MODEL for compatibility.
# Leave these empty to use Luna for all routes; overrides are explicit.
OPENAI_GENERAL_MODEL=
OPENAI_ROBOT_PLANNER_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=1024
MALBUT_AGENT_TIMEOUT_SECONDS=5
MALBUT_AGENT_PROVIDER_TOTAL_TIMEOUT_SECONDS=11
MALBUT_AGENT_PROVIDER_MAX_RETRIES=1
MALBUT_AGENT_PROVIDER_RETRY_BASE_DELAY_MS=250
MALBUT_AGENT_PROVIDER_RETRY_MAX_DELAY_MS=1000
MALBUT_AGENT_PROVIDER_FAILURE_THRESHOLD=2
MALBUT_AGENT_PROVIDER_RECOVERY_TIMEOUT_SECONDS=30
MALBUT_AGENT_MEMORY_LIMIT=5
MALBUT_AGENT_CONVERSATION_TTL_SECONDS=3600
MALBUT_AGENT_CONVERSATION_HISTORY_LIMIT=10
MALBUT_AGENT_CONVERSATION_SUMMARY_MAX_CHARS=2000
# OpenAI: local token estimate; compact in background at 90%, target 30%.
# Legacy history/summary character limits above apply to mock/RAI only.
# Full input has a separate 2x cap; output is reserved outside that cap.
MALBUT_AGENT_CONVERSATION_TOKEN_BUDGET=16384
MALBUT_AGENT_MAX_MODEL_INPUT_CHARS=20000
MALBUT_AGENT_MAX_CONCURRENT_REQUESTS=8
MALBUT_AGENT_REQUESTS_PER_MINUTE=60

# Home-camera VLM evaluation. Fine-tuned weights are deliberately not used;
# switch candidates by configuration while keeping one prompt/output contract.
# nova | gemini | qwen | openai_compatible
MALBUT_VLM_PROVIDER=nova
# Empty values select a provider-specific, version-controlled default.
MALBUT_VLM_MODEL=
MALBUT_VLM_REGION=
# Required by Gemini/Qwen, or by an authenticated compatible endpoint.
MALBUT_VLM_API_KEY=
# Required only for openai_compatible. Plain HTTP is limited to loopback.
MALBUT_VLM_BASE_URL=http://127.0.0.1:8000/v1
MALBUT_VLM_TIMEOUT_SECONDS=60
MALBUT_VLM_MAX_OUTPUT_TOKENS=1200

# Weather node: service key for data.go.kr KMA forecasts.
KMA_SERVICE_KEY=
