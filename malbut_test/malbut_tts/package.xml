<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>malbut_tts</name>
  <version>0.1.0</version>
  <description>Queue and stream speech with ROS playback controls.</description>
  <maintainer email="maintainers@example.com">SWM Malbut contributors</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>python3</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>malbut_interfaces</exec_depend>


  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
