# 웹 말하기 권한 ID. 갱신과 종료는 같은 ID를 사용한다.
string lease_id
# true: STT 입력 차단/갱신, false: 일치하는 권한만 종료
bool active
# active=true일 때 0 < ttl_s <= 15. 갱신이 끊기면 자동 복구한다.
float64 ttl_s
---
# STT web_talk_control: 입력/대기 오디오·이전 결과 차단과 TTS quiet 확인 완료.
# TTS playback_web_talk_control: lease 적용 및 실제 재생 작업 정리까지 확인 완료.
# active=false는 해당 lease의 해제 접수이며 별도 재생 완료를 뜻하지 않는다.
bool accepted
