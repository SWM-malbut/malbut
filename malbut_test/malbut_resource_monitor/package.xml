<?xml version="1.0"?>
<package format="3">
  <name>malbut_resource_monitor</name>
  <version>0.1.0</version>
  <description>Passive real-robot resource and ROS observation recorder, with an offline viewer.</description>
  <maintainer email="sanggeunji0117@gmail.com">Malbut Team</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>malbut_interfaces</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>std_msgs</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
