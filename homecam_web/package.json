{
  "name": "malbut-homecam-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern public/vendor",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "provisioning:bundle": "node scripts/create-provisioning-bundle.mjs",
    "provisioning:apply": "node --env-file-if-exists=.env.local scripts/apply-provisioning.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "3.1108.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "drizzle-orm": "0.45.2",
    "hls.js": "1.6.12",
    "next": "16.2.12",
    "pg": "^8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.15.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "fast-uri": "3.1.4",
    "brace-expansion": "5.0.9",
    "js-yaml": "4.3.1",
    "minimatch": "10.2.5",
    "nanoid": "3.3.17",
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "type": "module"
}
