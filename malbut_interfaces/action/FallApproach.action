# Drive near an uncertain fall suspicion to look closely, until the person's torso
# is in view (view, watching the pose detector), or back afterwards; or only hold
# the wheels (hold).
# The fall coordinator owns the sequence; no question or alert happens here.
# A fall check keeps a HIGH mission the whole time (the user, 2026-10-13): after
# approach and view the goal reports its outcome as feedback and holds the
# wheels in place until the next step replaces it or it is canceled.
string APPROACH=approach
string VIEW=view
string RETURN=return
string HOLD=hold
string request_id
string phase
# Map frame point of the suspicion (approach and view).
float64 x
float64 y
# Stop this far from the point, facing it (approach); at most this far (view).
float64 standoff_m 1.0
# Why it goes back (return only): not_a_person or off_floor; shown on the patrol card.
string reason
---
string ARRIVED=arrived
string RETURNED=returned
string NO_MAP=no_map
string NO_PATH=no_path
string TIMEOUT=timeout
string FAILED=failed
string outcome
string detail
---
# PLANNING, DRIVING, TURNING, LOOKING, HOLDING
string phase
# Set once the drive ended (as in the result), while the goal keeps holding.
string outcome
string detail
