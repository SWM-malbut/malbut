[
  {"id": "manual_01", "text": "오늘 날씨가 어때?"},
  {"id": "manual_02", "text": "거실로 가."},
  {"id": "manual_03", "text": "거실로 가지 마."},
  {"id": "manual_04", "text": "지금 정지해."},
  {"id": "manual_05", "text": "아니, 멈춰 줘."},
  {"id": "manual_06", "text": "방금 요청한 이동을 취소해 줘."},
  {"id": "manual_07", "text": "그 요청은 취소하지 마."},
  {"id": "manual_08", "text": "앞으로 조금 이동해 줘."},
  {"id": "manual_09", "text": "뒤로 조금 이동해 줘."},
  {"id": "manual_10", "text": "왼쪽으로 돌아 줘."},
  {"id": "manual_11", "text": "오른쪽으로 돌아 줘."},
  {"id": "manual_12", "text": "내 옆으로 와 줘."},
  {"id": "manual_13", "text": "움직이지 말고 여기서 기다려."},
  {"id": "manual_14", "text": "문 앞에서 멈춰 줘."},
  {"id": "manual_15", "text": "장애물이 있으면 더 가까이 가지 마."},
  {"id": "manual_16", "text": "지금 어디에 있어?"},
  {"id": "manual_17", "text": "배터리가 얼마나 남았어?"},
  {"id": "manual_18", "text": "지금 몇 시야?"},
  {"id": "manual_19", "text": "십오 분 타이머를 맞춰 줘."},
  {"id": "manual_20", "text": "오늘 할 일을 차례대로 알려 줘."}
]
