HOMECAM_DEVICE_TOKEN_FILE=/etc/malbut-homecam.token
HOMECAM_BACKEND_URL=https://replace-with-homecam-backend
HOMECAM_DEVICE_ID=replace-with-registered-device-id
HOMECAM_IMAGE_TOPIC=/replace/with/discovered/rgb/image_raw
HOMECAM_CAMERA_INFO_TOPIC=/replace/with/discovered/rgb/camera_info
# Enable only when the driver confirms this depth image is aligned to RGB.
HOMECAM_DEPTH_IMAGE_TOPIC=
HOMECAM_DEPTH_CAMERA_INFO_TOPIC=
HOMECAM_DEPTH_ALIGNED_TO_RGB=false
HOMECAM_DEPTH_SCALE_M=0.0
HOMECAM_DEPTH_MAX_STAMP_DELTA_SEC=0.15
HOMECAM_CAMERA_HEIGHT_M=0.091864
HOMECAM_CAMERA_PITCH_RAD=0.0
HOMECAM_ODOM_TOPIC=/odom
HOMECAM_NAVIGATION_STATUS_TOPIC=/navigate_to_pose/_action/status
HOMECAM_MODEL_PATH=/opt/homecam/models/yolo26n.onnx
HOMECAM_POSE_MODEL_PATH=/opt/homecam/models/yolo26n-pose.onnx
HOMECAM_AUDIO_SOURCE=default
HOMECAM_AUDIO_SINK=default
