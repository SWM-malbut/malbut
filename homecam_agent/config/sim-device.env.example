# Copy with scripts/configure_sim_device.sh instead of editing this file.
# Each computer must receive its own registered device id and token.
HOMECAM_DEVICE_ID=replace-with-registered-device-id
HOMECAM_BACKEND_URL=https://replace-with-homecam-backend
HOMECAM_DEVICE_TOKEN_FILE=device.token

# Reproducible Gazebo asset profile.
HOMECAM_WORLD=small_house
HOMECAM_START_GAZEBO=true
# Headless is the stable default for browser-streaming demos. Set GUI=true
# and HEADLESS=false only when the local Gazebo window is needed.
HOMECAM_GAZEBO_GUI=false
HOMECAM_GAZEBO_HEADLESS=true

# Blank image/CameraInfo values enable ROS topic auto-discovery.
HOMECAM_IMAGE_TOPIC=
HOMECAM_CAMERA_INFO_TOPIC=
HOMECAM_ODOM_TOPIC=/odom
HOMECAM_TOPIC_TIMEOUT_SECONDS=90

HOMECAM_AUDIO_SOURCE=default
HOMECAM_AUDIO_SINK=default
# false uses a silent Opus track, so a microphone-less PC can still stream.
HOMECAM_MICROPHONE_ENABLED=false
HOMECAM_MODEL_PATH=
HOMECAM_MONITORING_ENABLED=false

# Usually auto-detected from the repository location.
# HOMECAM_WORKSPACE=/absolute/path/to/homecam_ws
# HOMECAM_KVS_SDK_ROOT=/absolute/path/to/kvs-sdk-v1.19.1
