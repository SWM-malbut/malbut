<?xml version="1.0"?>
<sdf version="1.8">
  <world name="test_arena">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-imu-system"
            name="ignition::gazebo::systems::Imu"/>

    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.65 0.65 0.65</ambient_light>
        <background_color>0.80 0.86 0.93</background_color>
        <camera_pose>5 -5 5 0 0.6 2.35</camera_pose>
      </plugin>
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <property type="string" key="state">floating</property>
          <property type="bool" key="showTitleBar">false</property>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
      </plugin>
      <plugin filename="Teleop" name="ignition::gui::plugins::Teleop">
        <topic>/cmd_vel</topic>
        <ignition-gui>
          <property type="bool" key="showTitleBar">true</property>
          <property type="string" key="state">docked</property>
          <property key="resizable" type="bool">true</property>
        </ignition-gui>
      </plugin>
      <plugin filename="EntityTree" name="Entity tree">
        <gz-gui>
          <property type="string" key="state">docked_collapsed</property>
        </gz-gui>
      </plugin>
      <plugin filename="ComponentInspector" name="Component inspector">
        <gz-gui>
          <property type="string" key="state">docked_collapsed</property>
        </gz-gui>
      </plugin>
    </gui>

    <scene>
      <ambient>0.65 0.65 0.65 1</ambient>
      <background>0.80 0.86 0.93 1</background>
      <shadows>true</shadows>
      <grid>true</grid>
    </scene>
    <light type="directional" name="sun">
      <pose>0 0 8 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.95 0.95 0.95 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.25 -0.88</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>8 6</size></plane>
          </geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>8 6</size></plane>
          </geometry>
          <material>
            <ambient>0.70 0.70 0.70 1</ambient>
            <diffuse>0.70 0.70 0.70 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- The clear driving area is 6.0 x 4.0 metres. -->
    <model name="arena_walls">
      <static>true</static>
      <link name="walls">
        <collision name="north">
          <pose>0 2.05 0.20 0 0 0</pose>
          <geometry><box><size>6.2 0.10 0.40</size></box></geometry>
        </collision>
        <collision name="south">
          <pose>0 -2.05 0.20 0 0 0</pose>
          <geometry><box><size>6.2 0.10 0.40</size></box></geometry>
        </collision>
        <collision name="east">
          <pose>3.05 0 0.20 0 0 0</pose>
          <geometry><box><size>0.10 4.2 0.40</size></box></geometry>
        </collision>
        <collision name="west">
          <pose>-3.05 0 0.20 0 0 0</pose>
          <geometry><box><size>0.10 4.2 0.40</size></box></geometry>
        </collision>
        <visual name="north_visual">
          <pose>0 2.05 0.20 0 0 0</pose>
          <geometry><box><size>6.2 0.10 0.40</size></box></geometry>
          <material><diffuse>0.85 0.85 0.88 1</diffuse></material>
        </visual>
        <visual name="south_visual">
          <pose>0 -2.05 0.20 0 0 0</pose>
          <geometry><box><size>6.2 0.10 0.40</size></box></geometry>
          <material><diffuse>0.85 0.85 0.88 1</diffuse></material>
        </visual>
        <visual name="east_visual">
          <pose>3.05 0 0.20 0 0 0</pose>
          <geometry><box><size>0.10 4.2 0.40</size></box></geometry>
          <material><diffuse>0.85 0.85 0.88 1</diffuse></material>
        </visual>
        <visual name="west_visual">
          <pose>-3.05 0 0.20 0 0 0</pose>
          <geometry><box><size>0.10 4.2 0.40</size></box></geometry>
          <material><diffuse>0.85 0.85 0.88 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Known-size targets for LiDAR range and camera direction checks. -->
    <model name="one_meter_lidar_target">
      <static>true</static>
      <pose>1.50 0 0.30 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.05 1.0 0.60</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 1.0 0.60</size></box></geometry>
          <material><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="camera_color_target">
      <static>true</static>
      <pose>1.43 0 0.65 0 0 0</pose>
      <link name="link">
        <visual name="red">
          <pose>0 0.30 0 0 0 0</pose>
          <geometry><box><size>0.02 0.25 0.25</size></box></geometry>
          <material><diffuse>1 0.05 0.05 1</diffuse></material>
        </visual>
        <visual name="green">
          <geometry><box><size>0.02 0.25 0.25</size></box></geometry>
          <material><diffuse>0.05 1 0.05 1</diffuse></material>
        </visual>
        <visual name="blue">
          <pose>0 -0.30 0 0 0 0</pose>
          <geometry><box><size>0.02 0.25 0.25</size></box></geometry>
          <material><diffuse>0.05 0.05 1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="collision_box">
      <static>true</static>
      <pose>-1.20 0.80 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.50 0.50 0.50</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.50 0.50 0.50</size></box></geometry>
          <material><diffuse>0.75 0.42 0.12 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="cylindrical_target">
      <static>true</static>
      <pose>-1.20 -0.80 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.15</radius><length>0.70</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.15</radius><length>0.70</length></cylinder></geometry>
          <material><diffuse>0.2 0.55 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="low_ramp">
      <static>true</static>
      <pose>0 -1.30 0.075 0 0.15 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0 0.70 0.08</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 0.70 0.08</size></box></geometry>
          <material><diffuse>0.35 0.35 0.38 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
