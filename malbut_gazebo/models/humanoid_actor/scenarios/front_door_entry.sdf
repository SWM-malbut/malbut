<?xml version="1.0"?>
<sdf version="1.8">
  <actor name="scenario_humanoid">
    <skin>
      <filename>model://humanoid_actor/meshes/walk.dae</filename>
      <scale>1.0</scale>
    </skin>

    <animation name="walking">
      <filename>model://humanoid_actor/meshes/walk.dae</filename>
      <scale>1.0</scale>
      <interpolate_x>true</interpolate_x>
    </animation>

    <animation name="stand">
      <filename>model://humanoid_actor/meshes/stand.dae</filename>
      <scale>1.0</scale>
      <interpolate_x>true</interpolate_x>
    </animation>

    <!--
      SWM25-94 demonstration route designed specifically for the scenario.
      The actor starts outside Door_01 at map (6.0, -6.2), then follows the
      entrance, kitchen aisle, dining aisle, gym threshold, central living
      room, bedroom threshold, south living room, and entrance in that order.
      It does not enter the narrow bedside or the inner gym area. Translation
      is 0.45 m/s and turns use 1.20 rad/s.

      The walking animation name matches the trajectory type and interpolate_x
      synchronizes the skeleton with translation, as required by the upstream
      Gazebo actor. Every translation and in-place turn is kept in a separate
      trajectory so interpolation cannot blend a turn into diagonal walking.
      Translation yaw is atan2(dy, dx) and remains fixed for the whole segment.
      Moving segments use the upstream walk animation with interpolate_x, while
      in-place turns use the upstream stand animation. Tension 1.0 prevents
      spline overshoot at walls and doors. The final pose
      exactly matches the first pose for a continuous loop.
    -->
    <script>
      <loop>true</loop>
      <delay_start>0.0</delay_start>
      <auto_start>true</auto_start>
      <trajectory id="0" type="walking" tension="1.0">
