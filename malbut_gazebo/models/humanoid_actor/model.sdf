<?xml version="1.0"?>
<sdf version="1.8">
  <actor name="humanoid_target">
    <!-- The skeleton origin is at the hips, one metre above the floor. -->
    <skin>
      <filename>model://humanoid_actor/meshes/walk.dae</filename>
      <scale>1.0</scale>
    </skin>

    <animation name="walking">
      <filename>model://humanoid_actor/meshes/walk.dae</filename>
      <scale>1.0</scale>
      <interpolate_x>true</interpolate_x>
    </animation>

    <!--
      A deterministic 0.45 m/s Small House perception-demo circuit. The
      centerline is planned on the saved occupancy map after inflating walls
      and furniture by 0.55 m. Tension 1.0 prevents the trajectory spline
      from overshooting those verified straight segments. Repeated poses turn
      the actor before each segment, and the final pose matches the first so
      looping has no teleport discontinuity.
    -->
    <script>
