  <actor name="humanoid_target">
    <!-- The skeleton origin is at the hips, one metre above the floor. -->
    <skin>
      <filename>model://humanoid_actor/meshes/walk.dae</filename>
      <scale>1.0</scale>
    </skin>

    <animation name="walking">
      <filename>model://humanoid_actor/meshes/walk.dae</filename>
      <scale>1.0</scale>
      <interpolate_x>true</interpolate_x>
    </animation>

    <!--
      A deterministic 0.70 m/s full Small House circuit generated from the
      world SDF collision meshes. Straight segments retain at least 0.30 m
      clearance from wall, door, and full-height furniture geometry.
      Repeated poses turn the actor before each segment, and the final pose
      matches the first so looping has no teleport discontinuity.
    -->
