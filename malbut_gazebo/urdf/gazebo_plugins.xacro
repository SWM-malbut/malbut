<?xml version="1.0"?>
<robot
  xmlns:xacro="http://www.ros.org/wiki/xacro"
  xmlns:ignition="http://ignitionrobotics.org/schema">
  <xacro:arg name="lidar_enabled" default="true"/>
  <xacro:arg name="depth_camera_enabled" default="true"/>
  <xacro:arg name="imu_enabled" default="true"/>

  <xacro:macro name="mecanum_friction" params="link direction">
    <gazebo reference="${link}">
      <collision>
        <surface>
          <friction>
            <ode>
              <mu>${wheel_surface_mu1}</mu>
              <mu2>${wheel_surface_mu2}</mu2>
              <fdir1 ignition:expressed_in="base_footprint">
                ${direction}
              </fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="rosorin_gazebo">
    <gazebo reference="base_link">
      <material>Gazebo/Orange</material>
    </gazebo>
    <gazebo reference="upper_body_link">
      <material>Gazebo/Grey</material>
    </gazebo>
    <gazebo reference="camera_link">
      <material>Gazebo/DarkGrey</material>
    </gazebo>
    <gazebo reference="laser_frame">
      <material>Gazebo/DarkGrey</material>
    </gazebo>

    <!-- Same directional-friction approximation used by Fortress' mecanum demo. -->
    <xacro:mecanum_friction link="front_left_wheel_link" direction="1 -1 0"/>
    <xacro:mecanum_friction link="front_right_wheel_link" direction="1 1 0"/>
    <xacro:mecanum_friction link="rear_left_wheel_link" direction="1 1 0"/>
    <xacro:mecanum_friction link="rear_right_wheel_link" direction="1 -1 0"/>

    <gazebo>
      <plugin
        filename="ignition-gazebo-mecanum-drive-system"
        name="ignition::gazebo::systems::MecanumDrive">
        <front_left_joint>front_left_wheel_joint</front_left_joint>
        <front_right_joint>front_right_wheel_joint</front_right_joint>
        <back_left_joint>rear_left_wheel_joint</back_left_joint>
        <back_right_joint>rear_right_wheel_joint</back_right_joint>
        <wheel_separation>${wheel_separation}</wheel_separation>
        <wheelbase>${wheelbase}</wheelbase>
        <wheel_radius>${wheel_radius}</wheel_radius>
        <topic>/cmd_vel</topic>
        <min_acceleration>${drive_min_acceleration}</min_acceleration>
        <max_acceleration>${drive_max_acceleration}</max_acceleration>
        <min_velocity>${drive_min_velocity}</min_velocity>
        <max_velocity>${drive_max_velocity}</max_velocity>
      </plugin>

      <!-- Fortress 6 MecanumDrive commands wheels but does not publish odom. -->
      <plugin
        filename="ignition-gazebo-odometry-publisher-system"
        name="ignition::gazebo::systems::OdometryPublisher">
        <odom_frame>odom</odom_frame>
        <robot_base_frame>base_footprint</robot_base_frame>
        <dimensions>2</dimensions>
        <odom_publish_frequency>${odom_publish_frequency}</odom_publish_frequency>
        <odom_topic>/odom</odom_topic>
        <tf_topic>/tf</tf_topic>
      </plugin>

      <plugin
        filename="ignition-gazebo-joint-state-publisher-system"
        name="ignition::gazebo::systems::JointStatePublisher">
        <topic>/joint_states</topic>
        <joint_name>front_left_wheel_joint</joint_name>
        <joint_name>front_right_wheel_joint</joint_name>
        <joint_name>rear_left_wheel_joint</joint_name>
        <joint_name>rear_right_wheel_joint</joint_name>
      </plugin>
    </gazebo>

    <xacro:if value="$(arg lidar_enabled)">
      <gazebo reference="laser_frame">
        <sensor name="stl19p_d500" type="gpu_lidar">
          <!--
            The profile locates laser_frame at the D500 enclosure center.
            Emit rays from the top scan plane so they do not intersect the
            upper-body collision geometry directly below the sensor.
          -->
          <pose>0 0 ${lidar_height / 2.0} 0 0 0</pose>
          <always_on>true</always_on>
          <update_rate>${lidar_rate}</update_rate>
          <visualize>false</visualize>
          <topic>/scan</topic>
          <gz_frame_id>laser_frame</gz_frame_id>
          <lidar>
            <scan>
              <horizontal>
                <samples>${lidar_samples}</samples>
                <resolution>1</resolution>
                <min_angle>${-pi}</min_angle>
                <max_angle>${pi}</max_angle>
              </horizontal>
              <vertical>
                <samples>1</samples>
                <resolution>1</resolution>
                <min_angle>0</min_angle>
                <max_angle>0</max_angle>
              </vertical>
            </scan>
            <range>
              <min>${lidar_min_range}</min>
              <max>${lidar_max_range}</max>
              <resolution>${lidar_range_resolution}</resolution>
            </range>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>${lidar_noise_stddev}</stddev>
            </noise>
          </lidar>
        </sensor>
      </gazebo>
    </xacro:if>

    <xacro:if value="$(arg depth_camera_enabled)">
      <gazebo reference="camera_link">
        <sensor name="aurora930_pro" type="rgbd_camera">
          <always_on>true</always_on>
          <update_rate>${camera_rate}</update_rate>
          <visualize>false</visualize>
          <topic>/rgbd_camera</topic>
          <gz_frame_id>camera_depth_optical_frame</gz_frame_id>
          <camera>
            <horizontal_fov>${camera_hfov}</horizontal_fov>
            <image>
              <width>${camera_width_px}</width>
              <height>${camera_height_px}</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>${camera_near}</near>
              <far>${camera_far}</far>
            </clip>
            <depth_camera>
              <clip>
                <near>${depth_camera_near}</near>
                <far>${depth_camera_far}</far>
              </clip>
            </depth_camera>
          </camera>
        </sensor>
      </gazebo>
    </xacro:if>

    <xacro:if value="$(arg imu_enabled)">
      <gazebo reference="imu_link">
        <sensor name="controller_imu" type="imu">
          <always_on>true</always_on>
          <update_rate>${imu_rate}</update_rate>
          <topic>/imu</topic>
          <gz_frame_id>imu_link</gz_frame_id>
        </sensor>
      </gazebo>
    </xacro:if>
  </xacro:macro>
</robot>
